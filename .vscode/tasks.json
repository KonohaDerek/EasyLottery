{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet: restore",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "restore",
        "EasyLottery.generated.sln"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "dotnet: build solution",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "EasyLottery.generated.sln",
        "-c",
        "Debug"
      ],
      "group": "build",
      "dependsOn": "dotnet: restore",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "debug: cleanup api port",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "set -euo pipefail; docker compose down --remove-orphans >/dev/null 2>&1 || true; pids=$(lsof -tiTCP:18930 -sTCP:LISTEN || true); if [ -n \"$pids\" ]; then kill $pids; fi"
      ],
      "problemMatcher": []
    },
    {
      "label": "debug: prepare local full stack",
      "dependsOn": [
        "debug: cleanup api port",
        "dotnet: build solution"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "dotnet: run api",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/EasyLotteryAPI/EasyLotteryApi.csproj",
        "--launch-profile",
        "EasyLotteryAPI"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: stop api port",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "pids=$(lsof -tiTCP:18930 -sTCP:LISTEN); if [ -n \"$pids\" ]; then kill $pids; fi"
      ],
      "problemMatcher": []
    },
    {
      "label": "compose: up api",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "set -euo pipefail; docker compose up -d --build api"
      ],
      "problemMatcher": []
    },
    {
      "label": "compose: rebuild api (no cache)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "set -euo pipefail; docker compose build --no-cache api && docker compose up -d api"
      ],
      "problemMatcher": []
    },
    {
      "label": "compose: down api",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "set -euo pipefail; docker compose down --remove-orphans"
      ],
      "problemMatcher": []
    }
  ]
}
