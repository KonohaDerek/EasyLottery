<Toaster>
    <Toast @bind-Visible="@ToastVisible">
        <ToastBody>
            @ToastMessage
        </ToastBody>
    </Toast>
</Toaster>

@code {
    private string ToastMessage = "";

    private bool ToastVisible = false;
    private void OnItemClick()
    {
        ToastMessage = "Item clicked";
        ToastVisible = true;
        StateHasChanged();
        return;
    }
}