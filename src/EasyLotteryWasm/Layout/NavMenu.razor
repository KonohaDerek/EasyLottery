@implements IDisposable
@inject YouTubeServiceHelper youTubeServiceHelper
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="nav-menu-root @(sidebarCollapsed ? "is-collapsed" : string.Empty) @(mobileMenuOpen ? "mobile-open" : string.Empty)">
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="" aria-label="抽獎系統首頁">
                <span class="brand-full">抽獎系統</span>
                <span class="brand-short" aria-hidden="true">EZ</span>
            </a>
            <button type="button" title="開啟或關閉導覽選單" class="navbar-toggler mobile-menu-toggle"
                    aria-label="開啟或關閉導覽選單" aria-expanded="@mobileMenuOpen" @onclick="ToggleMobileMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <button type="button" title="收合或展開側邊欄" class="navbar-toggler desktop-menu-toggle"
                    aria-label="收合或展開側邊欄" aria-expanded="@(!sidebarCollapsed)" @onclick="ToggleDesktopSidebar">
                <span class="sidebar-toggle-icon" aria-hidden="true">@(sidebarCollapsed ? "»" : "«")</span>
            </button>
        </div>
    </div>

    <div class="@NavMenuCssClass nav-scrollable">
        <nav class="flex-column" aria-label="主要導覽">
            <div class="nav-item px-3 nav-home-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="抽獎首頁／控制台" @onclick="CloseMobileMenu">
                    <span class="nav-icon" aria-hidden="true">⌂</span>
                    <span class="nav-label">抽獎首頁／控制台</span>
                </NavLink>
            </div>

            @foreach (var group in NavigationCatalog.Groups)
            {
                var isExpanded = IsGroupExpanded(group);
                var groupId = $"nav-group-{group.Id}";
                <div class="nav-group">
                    <button type="button" class="nav-group-header px-3 @(IsActiveGroup(group) ? "has-active-route" : string.Empty)"
                            aria-expanded="@isExpanded" aria-controls="@groupId" @onclick="() => ToggleGroup(group.Id)">
                        <span class="nav-group-icon" aria-hidden="true">@group.Icon</span>
                        <span class="nav-group-title">@group.Label</span>
                        <span class="nav-group-chevron @(isExpanded ? "expanded" : string.Empty)" aria-hidden="true">▸</span>
                    </button>
                    <div id="@groupId" class="nav-group-children @(isExpanded ? "expanded" : "collapsed")" role="region" aria-label="@group.Label">
                        @foreach (var item in group.Items)
                        {
                            <div class="nav-item px-3 nav-sub-item">
                                <NavLink class="nav-link" href="@item.Route" Match="NavLinkMatch.Prefix"
                                         title="@item.Label" aria-label="@item.Description" @onclick="CloseMobileMenu">
                                    <span class="nav-icon" aria-hidden="true">@item.Icon</span>
                                    <span class="nav-label">@item.Label</span>
                                </NavLink>
                            </div>
                        }
                    </div>
                </div>
            }
        </nav>
    </div>

    <div class="nav-login-status px-3">
        <div class="status-indicator" title="YouTube API 設定狀態">
            @if (hasYoutubeApiKey)
            {
                <span class="status-dot status-online" aria-hidden="true"></span>
                <span class="status-text">YT API 已設定</span>
            }
            else
            {
                <span class="status-dot status-offline" aria-hidden="true"></span>
                <span class="status-text">YT API 未設定</span>
            }
        </div>
    </div>

    @if (mobileMenuOpen)
    {
        <button type="button" class="nav-backdrop" aria-label="關閉導覽選單" @onclick="CloseMobileMenu"></button>
    }
</div>

@code {
    private const string ExpandedGroupsStorageKey = "easylottery.navigation.expanded-groups";

    private readonly HashSet<string> expandedGroups = new(StringComparer.OrdinalIgnoreCase);
    private bool sidebarCollapsed;
    private bool mobileMenuOpen;
    private bool hasYoutubeApiKey;
    private bool expandedStateLoaded;

    private string? NavMenuCssClass => mobileMenuOpen ? "mobile-expanded" : "mobile-collapsed";

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        EnsureActiveGroupExpanded();
    }

    protected override async Task OnInitializedAsync()
    {
        hasYoutubeApiKey = await youTubeServiceHelper.HasConfiguredCredentialsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || expandedStateLoaded)
        {
            return;
        }

        expandedStateLoaded = true;
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", ExpandedGroupsStorageKey);
            if (!string.IsNullOrWhiteSpace(stored))
            {
                var persisted = System.Text.Json.JsonSerializer.Deserialize<HashSet<string>>(stored);
                if (persisted is not null)
                {
                    expandedGroups.UnionWith(persisted);
                }
            }
        }
        catch (JSException)
        {
            // Navigation should still work when storage is unavailable or blocked.
        }

        EnsureActiveGroupExpanded();
        await InvokeAsync(StateHasChanged);
    }

    private bool IsGroupExpanded(NavigationGroup group) => expandedGroups.Contains(group.Id);

    private bool IsActiveGroup(NavigationGroup group) =>
        string.Equals(NavigationCatalog.FindGroupId(CurrentPath()), group.Id, StringComparison.OrdinalIgnoreCase);

    private string CurrentPath() => NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

    private void ToggleGroup(string groupId)
    {
        if (!expandedGroups.Add(groupId))
        {
            expandedGroups.Remove(groupId);
        }

        _ = PersistExpandedGroupsAsync();
    }

    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;

    private void ToggleDesktopSidebar() => sidebarCollapsed = !sidebarCollapsed;

    private void CloseMobileMenu() => mobileMenuOpen = false;

    private void EnsureActiveGroupExpanded()
    {
        var activeGroupId = NavigationCatalog.FindGroupId(CurrentPath());
        if (!string.IsNullOrWhiteSpace(activeGroupId) && activeGroupId != NavigationCatalog.HomeGroupId)
        {
            expandedGroups.Add(activeGroupId);
        }
    }

    private async Task PersistExpandedGroupsAsync()
    {
        try
        {
            var serialized = System.Text.Json.JsonSerializer.Serialize(expandedGroups);
            await JS.InvokeVoidAsync("localStorage.setItem", ExpandedGroupsStorageKey, serialized);
        }
        catch (JSException)
        {
            // Persistence is optional; keep the current UI state in memory.
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        EnsureActiveGroupExpanded();
        CloseMobileMenu();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => NavigationManager.LocationChanged -= HandleLocationChanged;
}
