@implements IDisposable
@inject YouTubeServiceHelper youTubeServiceHelper

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">抽獎系統</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable">

    <nav class="flex-column">
        @* === 1. 抽獎 === *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> 抽獎
            </NavLink>
        </div>

        @* === 2. 活動配置 === *@
        <div class="nav-group-header px-3" @onclick="ToggleActivityGroup">
            <span class="bi bi-grid-3x3-gap-fill" aria-hidden="true"></span>
            <span class="nav-group-title">活動配置</span>
            <span class="nav-group-chevron @(activityGroupExpanded ? "expanded" : "")">&#9656;</span>
        </div>
        @if(activityGroupExpanded)
        {
            <div class="nav-item px-3 nav-sub-item">
                <NavLink class="nav-link" href="pokebox">
                    戳戳樂
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-sub-item">
                <NavLink class="nav-link" href="roulette">
                    轉盤
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-sub-item">
                <NavLink class="nav-link" href="activity-results">
                    活動結果
                </NavLink>
            </div>
        }

        @* === 3. 系統配置 === *@
        <div class="nav-group-header px-3" @onclick="ToggleSystemGroup">
            <span class="bi bi-gear-nav-menu" aria-hidden="true"></span>
            <span class="nav-group-title">系統配置</span>
            <span class="nav-group-chevron @(systemGroupExpanded ? "expanded" : "")">&#9656;</span>
        </div>
        @if(systemGroupExpanded)
        {
            <div class="nav-item px-3 nav-sub-item">
                <NavLink class="nav-link" href="system/payment">
                    支付配置
                </NavLink>
            </div>
            <div class="nav-item px-3 nav-sub-item">
                <NavLink class="nav-link" href="system/youtube-login">
                    YouTube 登入
                </NavLink>
            </div>
        }

    </nav>
</div>

<div class="nav-login-status px-3">
    <div class="status-indicator">
        @if(youTubeServiceHelper.IsAuthorized)
        {
            <span class="status-dot status-online"></span>
            <span class="status-text">YT 已登入</span>
        }
        else
        {
            <span class="status-dot status-offline"></span>
            <span class="status-text">YT 未登入</span>
        }
    </div>
</div>

@code {
    private bool collapseNavMenu = false;
    private bool activityGroupExpanded = false;
    private bool systemGroupExpanded = false;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized()
    {
        youTubeServiceHelper.AuthStateChanged += OnAuthStateChanged;
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void ToggleActivityGroup()
    {
        activityGroupExpanded = !activityGroupExpanded;
    }

    private void ToggleSystemGroup()
    {
        systemGroupExpanded = !systemGroupExpanded;
    }

    public void Dispose()
    {
        youTubeServiceHelper.AuthStateChanged -= OnAuthStateChanged;
    }
}
