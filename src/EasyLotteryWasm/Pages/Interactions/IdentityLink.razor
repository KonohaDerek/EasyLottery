@page "/interactions/identity-link"
@inject IdentityLinkApiClient Links
@inject IMessageService MessageService

<PageTitle>觀眾身份綁定</PageTitle>
<h1 class="h2">觀眾身份綁定</h1>
<p class="text-muted">請輸入主持人或另一個平台產生的一次性綁定碼。綁定碼過期或使用後即失效。</p>
<Field><FieldLabel>一次性綁定碼</FieldLabel><TextInput @bind-Value="code" /></Field>
<Button Color="Color.Primary" Clicked="CompleteAsync" Disabled="@string.IsNullOrWhiteSpace(code)">完成綁定</Button>
@if (!string.IsNullOrWhiteSpace(message)) { <p class="mt-3">@message</p> }
@code {
    private string code = "";
    private string message = "";
    private async Task CompleteAsync()
    {
        try { await Links.CompleteAsync(code.Trim()); message = "身份綁定完成。"; code = ""; await MessageService.Success(message); }
        catch (HttpRequestException) { message = "綁定碼無效、過期或已使用。"; }
    }
}
