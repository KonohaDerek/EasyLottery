@code {
    [Parameter] public string ActivityRouteKey { get; set; } = "";
    private DonateLotteryActivity? activity;
    private bool isLoading = true;
    private DonateObsRevealState revealState = new();
    private readonly Queue<DonateLotteryDrawRecord> pendingResults = new();
    private int? queueActivityId;
    private int? lastSeenRecordId;
    private bool prizeImageFailed;
    private bool testPanelOpen;
    private string testDonorName = "測試贊助者";
    private decimal testAmount = 100m;
    private string testMessage = "這是一則 OBS Donate 測試通知";
    private string testPaymentMethod = "測試付款";
    private string testResult = "";
    private string? aiCongratulation;
    private int AnimationDurationSeconds => Math.Clamp(activity?.AnimationDurationSeconds ?? 8, 3, 30);
    private DonateLotteryDrawRecord? latestWin => revealState.CurrentResult;
    private string RevealPhaseClass => revealState.Phase switch { DonateObsRevealPhase.Notification => "notification", DonateObsRevealPhase.Animation => "animation", _ => "reveal" };
    private DonateObsAnimationPresentation AnimationPresentation => DonateObsAnimationCatalog.Resolve(activity?.Animation ?? DonateLotteryAnimation.IchibanKuji);
    private string AnimationClass => AnimationPresentation.CssClass;
    private string PolaroidTemplateClass => $"polaroid-template-{(string.IsNullOrWhiteSpace(activity?.PolaroidTemplateKey) ? "classic" : activity.PolaroidTemplateKey)}";
    private string PolaroidFallbackCongratulation => latestWin is null
        ? ""
        : !latestWin.IsWinning
            ? $"感謝 {latestWin.DonorName} 的贊助與參與！"
            : PolaroidResultTemplateCatalog.Resolve(activity?.PolaroidTemplateKey).FallbackCongratulation
            .Replace("{donor}", latestWin.DonorName, StringComparison.Ordinal)
            .Replace("{prize}", latestWin.PrizeName, StringComparison.Ordinal);
    private bool IsGrandPrize => latestWin is not null && activity?.Prizes.Any(prize => prize.IsGrandPrize && string.Equals(prize.Name, latestWin.PrizeName, StringComparison.Ordinal)) == true;
    private string GaragaraBallClass => $"ball-{ResolveGaragaraBallColor()}";
    private readonly CancellationTokenSource cancellation = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _ = PollAsync();
    }

    private async Task RunTestAsync()
    {
        if (activity is null)
        {
            testResult = "測試失敗：找不到目前 OBS 對應的 Donate 活動。";
            return;
        }

        using var httpRequest = new HttpRequestMessage(HttpMethod.Post, $"api/obs/donate/{activity.PublicId:D}/test");
        httpRequest.Headers.Add(ObsSessionTokenHeader.Name, await ObsSessionService.GetSessionTokenAsync(cancellation.Token));
        httpRequest.Content = JsonContent.Create(new DonateObsTestRequest(testDonorName, testAmount, testMessage, testPaymentMethod));
        using var response = await HttpClient.SendAsync(httpRequest, cancellation.Token);
        if (!response.IsSuccessStatusCode)
        {
            testResult = $"測試失敗：API 回傳 {(int)response.StatusCode}。";
            return;
        }
        var result = await response.Content.ReadFromJsonAsync<DonateObsTestResponse>(cancellationToken: cancellation.Token);
        var testRecords = result?.Records ?? [];
        testResult = result?.Processed != true
            ? $"測試失敗：{result?.Reason}"
            : testRecords.Length == 0
                ? $"測試完成：贊助金額未達活動門檻 NT${activity.MinimumDonationAmount:N0}。"
                : $"測試通知已送出（{testPaymentMethod}）：{testDonorName} NT${testAmount:N0}，結果 {string.Join("、", testRecords.Select(win => win.PrizeName))}。留言：{testMessage}";
        await RefreshAsync();
    }

    private sealed record DonateObsTestRequest(string DonorName, decimal Amount, string Message, string PaymentMethod);
    private sealed record DonateObsTestResponse(bool Processed, string Reason, DonateLotteryDrawRecord[] Records);

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try { while (await timer.WaitForNextTickAsync(cancellation.Token)) { await RefreshAsync(); await InvokeAsync(StateHasChanged); } }
        catch (OperationCanceledException ex)
        {
            Log.Debug(ex, "Donate OBS polling loop cancelled.");
        }
    }

    private async Task RefreshAsync()
    {
        var document = await ConfigStore.LoadAsync(cancellation.Token);
        var publicId = Guid.TryParse(ActivityRouteKey, out var parsedPublicId) ? parsedPublicId : Guid.Empty;
        var legacyId = publicId == Guid.Empty && int.TryParse(ActivityRouteKey, out var parsedLegacyId) ? parsedLegacyId : 0;
        activity = document.DonateLotteryActivities.FirstOrDefault(item =>
            item.PublicId == publicId ||
            (legacyId > 0 && item.Id == legacyId));
        var records = activity is null
            ? []
            : document.DonateLotteryDrawRecords.Where(item => item.ActivityId == activity.Id).OrderBy(item => item.Id).ToList();
        var newestWin = records.LastOrDefault();

        if (activity is not null && queueActivityId != activity.Id)
        {
            queueActivityId = activity.Id;
            lastSeenRecordId = newestWin?.Id;
            pendingResults.Clear();
            revealState = new DonateObsRevealState();
        }

        DonateObsRevealTransition transition;
        if (!revealState.IsInitialized)
        {
            lastSeenRecordId = newestWin?.Id;
            transition = DonateObsRevealLifecycle.Advance(revealState, activity, newestWin, DateTimeOffset.UtcNow);
        }
        else
        {
            foreach (var record in records.Where(record => record.Id > (lastSeenRecordId ?? revealState.ObservedWinId ?? 0)))
            {
                pendingResults.Enqueue(record);
                lastSeenRecordId = Math.Max(lastSeenRecordId ?? 0, record.Id);
            }

            var nextResult = revealState.CurrentResult is null && pendingResults.Count > 0
                ? pendingResults.Dequeue()
                : null;
            transition = DonateObsRevealLifecycle.Advance(revealState, activity, nextResult, DateTimeOffset.UtcNow);
        }
        if (transition.IsNewResult)
        {
            prizeImageFailed = false;
            aiCongratulation = null;
        }
        else if (transition.EnteredReveal && latestWin is not null)
        {
            if (latestWin.IsWinning && activity?.UseAiCongratulation == true)
            {
                aiCongratulation = await AiCongratulationClient.GenerateAsync(activity.PublicId, latestWin.DonorName, latestWin.PrizeName, cancellation.Token);
            }
        }
        else if (transition.Cleared)
        {
            aiCongratulation = null;
        }
        isLoading = false;
    }

    public ValueTask DisposeAsync() { cancellation.Cancel(); cancellation.Dispose(); return ValueTask.CompletedTask; }

    private string ResolveGaragaraBallColor()
    {
        if (latestWin is null || activity is null || !latestWin.IsWinning) return "white";
        var prize = activity.Prizes.FirstOrDefault(item => string.Equals(item.Name, latestWin.PrizeName, StringComparison.Ordinal));
        if (prize?.IsGrandPrize == true) return "gold";
        var candidates = activity.Prizes.Where(item => item.RemainingQuantity > 0 || item.Quantity > 0).ToList();
        if (candidates.Count == 0) return "white";
        var white = candidates.OrderBy(item => item.Probability).ThenByDescending(item => item.RemainingQuantity).First();
        if (prize is not null && prize.Id == white.Id) return "white";
        var ordered = candidates.Where(item => item.Id != white.Id).OrderBy(item => item.Probability).ToList();
        var index = Math.Max(0, ordered.FindIndex(item => item.Id == prize?.Id));
        return new[] { "blue", "green", "yellow", "red", "copper", "silver" }[Math.Min(index, 5)];
    }
}
