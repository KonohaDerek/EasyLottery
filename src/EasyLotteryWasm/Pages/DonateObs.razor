@page "/obs/donate/{ActivityRouteKey}"
@layout EasyLotteryWasm.Layout.ObsLayout
@using EasyLotteryDomain.Models.Config
@using EasyLotteryDomain.Services
@using EasyLotteryWasm.Models
@using Serilog
@inject IEasyLotteryConfigStore ConfigStore
@inject AiCongratulationClient AiCongratulationClient
@inject HttpClient HttpClient
@inject EasyLotteryWasm.Services.ObsSessionService ObsSessionService
@using System.Net.Http.Json
@implements IAsyncDisposable

<PageTitle>Donate 抽獎 OBS</PageTitle>

<div class="donate-obs-shell">
    @if (!isLoading && activity is not null && latestWin is not null)
    {
        <div class="donate-reveal @AnimationClass @PolaroidTemplateClass phase-@RevealPhaseClass @(IsGrandPrize ? "grand-prize" : "")" style="--draw-duration:@AnimationDurationSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)s" @key="latestWin.Id">
            <section class="donate-notice" aria-label="新的 Donate 通知">
                <div class="donate-notice-eyebrow">NEW DONATE</div>
                <div class="donate-notice-name">@latestWin.DonorName</div>
                <div class="donate-notice-amount">NT$@latestWin.Amount.ToString("N0")</div>
                @if (!string.IsNullOrWhiteSpace(latestWin.DonationMessage)) { <div class="donate-notice-message">@latestWin.DonationMessage</div> }
                @if (!string.IsNullOrWhiteSpace(latestWin.PaymentMethod)) { <div class="donate-notice-payment">付款方式：@latestWin.PaymentMethod</div> }
            </section>
            <div class="donate-reveal-label">@(latestWin.IsWinning ? "DONATE RESULT" : "DONATE THANK YOU")</div>
            <DonateAnimationScene Animation="activity.Animation" PrizeName="latestWin.PrizeName" BallClass="@GaragaraBallClass" />
            <div class="donate-result-content">
            @if (!string.IsNullOrWhiteSpace(latestWin.PrizeImageUrl) && !prizeImageFailed)
            {
                <img class="donate-reveal-image" src="@latestWin.PrizeImageUrl" alt="@latestWin.PrizeName" @onerror="() => prizeImageFailed = true" />
                <div class="donate-reveal-prize">@latestWin.PrizeName</div>
            }
            else { <div class="donate-reveal-fallback">@latestWin.PrizeName</div> }
            <div class="donate-reveal-congratulation">@(aiCongratulation ?? PolaroidFallbackCongratulation)</div>
            @if (IsGrandPrize) { <div class="grand-prize-banner">★ 最大獎 ★</div> }
            </div>
        </div>
    }
</div>

@if (testPanelOpen)
{
    <section class="donate-test-panel" aria-label="Donate 測試面板">
        <div class="donate-test-panel-header"><strong>Donate 測試模式</strong><button class="donate-test-close" @onclick="() => testPanelOpen = false" aria-label="關閉 Donate 測試面板">×</button></div>
        <p>會以正式 Donate 相同的抽獎與 OBS 通知資料流建立測試紀錄，不會送出金流請求。</p>
        <input @bind="testDonorName" placeholder="贊助者名稱" aria-label="測試贊助者名稱" />
        <input type="number" min="1" @bind="testAmount" aria-label="測試贊助金額" />
        <input @bind="testMessage" placeholder="留言" aria-label="測試留言" />
        <input @bind="testPaymentMethod" placeholder="支付方式" aria-label="測試支付方式" />
        <button @onclick="RunTestAsync">送出測試 Donate</button>
        @if (!string.IsNullOrWhiteSpace(testResult)) { <div role="status">@testResult</div> }
    </section>
}
else
{
    <button class="donate-test-launch" @onclick="() => testPanelOpen = true">測試 Donate</button>
}

<style>
    .obs-layout:has(.donate-obs-shell) { align-items:flex-start; overflow-x:hidden; overflow-y:auto; }
    .donate-obs-shell { width:100%; min-height:100%; display:grid; place-items:center; background:transparent; color:white; font-family:system-ui,sans-serif; }
    .donate-reveal { width:min(94vw,72rem); box-sizing:border-box; display:grid; justify-items:center; gap:clamp(.45rem,1vh,.9rem); text-align:center; padding:clamp(.75rem,2vh,1.5rem); animation:donate-reveal .65s cubic-bezier(.16,1,.3,1); text-shadow:0 3px 18px #000; position:relative; overflow-x:clip; }
    .donate-notice { width:min(92vw,42rem); padding:1.25rem 1.5rem; border:2px solid #fde68a; border-radius:1.25rem; background:linear-gradient(135deg,rgba(45,15,82,.96),rgba(154,52,18,.92)); box-shadow:0 14px 38px rgba(0,0,0,.36); animation:notice-pop .5s ease-out both; }
    .donate-notice-eyebrow { color:#fde68a; font-size:.9rem; font-weight:900; letter-spacing:.2em; }.donate-notice-name{font-size:clamp(1.5rem,4vw,3rem);font-weight:950;overflow-wrap:anywhere}.donate-notice-amount{color:#fef3c7;font-size:clamp(1.4rem,3.5vw,2.6rem);font-weight:950}.donate-notice-message{margin-top:.4rem;white-space:pre-wrap;overflow-wrap:anywhere}.donate-notice-payment{margin-top:.4rem;color:#fde68a}
    .phase-notification .draw-prop,.phase-notification .donate-reveal-label,.phase-notification .donate-result-content,.phase-animation .donate-notice,.phase-animation .donate-reveal-label,.phase-animation .donate-result-content,.phase-reveal .donate-notice,.phase-reveal .draw-prop,.phase-reveal .donate-reveal-label{display:none}
    .phase-animation .draw-prop,
    .phase-animation .draw-prop *,
    .phase-reveal .donate-result-content,
    .phase-reveal .donate-result-content * {
        animation-iteration-count: 1;
        animation-fill-mode: both;
    }
    .polaroid-template-classic { --polaroid-accent:#ffd166; --polaroid-surface:linear-gradient(135deg,#6d28d9,#f59e0b); }
    .polaroid-template-celebration { --polaroid-accent:#f9a8d4; --polaroid-surface:linear-gradient(135deg,#ec4899,#7c3aed 52%,#22d3ee); }
    .donate-reveal::before { content:""; position:absolute; inset:-2.5rem; pointer-events:none; background:radial-gradient(circle at center, rgba(255,255,255,.16), transparent 60%); opacity:.7; filter:blur(14px); }
    .draw-prop { min-height:clamp(7rem,16vh,10rem); display:grid; place-items:center; margin:0 auto; perspective:1200px; position:relative; }
    .draw-prop > * { position:relative; }
    .animation-ichiban .ichiban-stage { width:min(22rem, 72vw); height:10rem; display:grid; place-items:center; position:relative; }
    .ichiban-curtain { position:absolute; top:0; bottom:0; width:40%; background:linear-gradient(180deg, rgba(190,24,93,.95), rgba(127,29,29,.95)); border:4px solid #fbbf24; box-shadow:inset 0 0 28px rgba(255,255,255,.2); }
    .ichiban-curtain-left { left:0; transform-origin:left center; border-radius:1rem 0 0 1rem; animation:curtain-open-left 1.2s ease-in-out infinite alternate; }
    .ichiban-curtain-right { right:0; transform-origin:right center; border-radius:0 1rem 1rem 0; animation:curtain-open-right 1.2s ease-in-out infinite alternate; }
    .ichiban-ribbon { position:absolute; inset:1.2rem 22%; border-radius:999px; background:linear-gradient(90deg,#f59e0b,#fef08a,#f59e0b); filter:blur(1px); animation:shine-sweep 2s linear infinite; }
    .ichiban-ticket { display:grid; place-items:center; width:13rem; height:5.5rem; color:#fff7d6; background:linear-gradient(135deg,#d90429,#7f1d1d); border:5px solid #fbbf24; border-radius:.75rem; font-size:2rem; font-weight:900; transform:rotate(-6deg); animation:ticket-reveal .8s ease-out, ticket-bob 1.8s ease-in-out infinite alternate; z-index:1; }
    .ichiban-box{position:absolute;width:15rem;height:7rem;display:grid;place-items:center;background:linear-gradient(135deg,#b91c1c,#450a0a);border:5px solid #fbbf24;border-radius:1rem;color:#fde68a;font-weight:950;font-size:2rem;animation:box-shake 1s linear infinite}.ichiban-hand{position:absolute;width:5rem;height:2.1rem;background:#f6c7a4;border-radius:999px;z-index:2;top:4rem}.ichiban-hand-left{left:2rem;animation:tear-left var(--draw-duration) ease-in forwards}.ichiban-hand-right{right:2rem;animation:tear-right var(--draw-duration) ease-in forwards}
    .ichiban-chibi { position:absolute; left:1rem; bottom:-.75rem; font-size:2rem; animation:chibi-pull 1.1s ease-in-out infinite alternate; }
    .animation-gacha .gacha-stage { width:min(25rem, 76vw); height:12rem; display:grid; place-items:center; position:relative; }
    .gacha-halo { position:absolute; width:8rem; height:8rem; border-radius:50%; background:radial-gradient(circle, rgba(253,224,71,.9), rgba(253,224,71,.12) 55%, transparent 70%); animation:halo-pulse 1.2s ease-in-out infinite alternate; }
    .gacha-machine { width:7rem; height:8rem; display:grid; place-items:center; border:10px solid #ff6b9d; border-radius:46% 46% 30% 30%; background:linear-gradient(180deg,#7c3aed,#4c1d95); box-shadow:inset 0 0 0 12px #fef3c7,0 10px 0 #312e81; animation:gacha-shake .25s linear infinite; position:relative; }
    .gacha-glass { position:absolute; inset:1.15rem .65rem 2rem; border-radius:50%; background:radial-gradient(circle at 35% 28%, rgba(255,255,255,.8), rgba(255,255,255,.1) 48%, rgba(255,255,255,.04) 70%); border:3px solid rgba(255,255,255,.6); }
    .gacha-slot { position:absolute; bottom:.8rem; left:50%; width:3rem; height:.5rem; transform:translateX(-50%); border-radius:999px; background:#fef08a; box-shadow:0 0 12px rgba(254,240,138,.95); }
    .gacha-crank { position:absolute; right:-1.9rem; bottom:1.5rem; width:2.5rem; height:2.5rem; border:.55rem solid #fde68a; border-radius:50%; box-shadow:0 0 0 .25rem #92400e; animation:crank-turn .9s linear infinite; }
    .gacha-capsule { position:absolute; top:-1.5rem; left:50%; width:2.15rem; height:3rem; transform:translateX(-50%); border-radius:999px; background:linear-gradient(180deg,#fde047 0 50%, #fb7185 50% 100%); box-shadow:0 .5rem 1rem rgba(0,0,0,.35); animation:capsule-drop 1.1s ease-in-out infinite; }
    .chibi-actor{width:3.7rem;height:4.5rem;position:absolute;display:grid;place-items:end center}.chibi-actor::before{content:"";position:absolute;top:0;width:2.7rem;height:2.7rem;border-radius:48% 48% 44% 44%;background:radial-gradient(circle at 35% 42%,#1f2937 0 .16rem,transparent .18rem),radial-gradient(circle at 65% 42%,#1f2937 0 .16rem,transparent .18rem),#ffd4bb;border:3px solid #5b2a22}.chibi-actor i{width:2.6rem;height:2.5rem;border-radius:1.3rem 1.3rem .7rem .7rem;background:linear-gradient(#f472b6,#7c3aed);border:3px solid #fff}.chibi-actor b{position:absolute;width:3.6rem;height:.45rem;bottom:1.7rem;border-radius:999px;background:#ffd4bb;transform:rotate(18deg)}
    .gacha-chibi { left:1rem; bottom:0; animation:chibi-turn-crank .9s ease-in-out infinite alternate; }
    .animation-garagara .garagara-stage { width:min(28rem, 82vw); height:12rem; display:grid; place-items:center; position:relative; }
    .garagara-arm { position:absolute; left:2.5rem; bottom:2.1rem; width:5rem; height:.65rem; background:linear-gradient(90deg,#b45309,#fbbf24); border-radius:999px; transform-origin:right center; transform:rotate(-24deg); animation:arm-turn .9s ease-in-out infinite alternate; }
    .garagara-chibi { left:0; bottom:1.25rem; animation:chibi-push 1s ease-in-out infinite alternate; }
    .garagara-ball{position:absolute;right:2rem;bottom:.5rem;width:2.35rem;height:2.35rem;border-radius:50%;box-shadow:inset -.35rem -.4rem rgba(0,0,0,.28),0 0 18px rgba(255,255,255,.7);animation:ball-drop var(--draw-duration) cubic-bezier(.2,.9,.3,1) forwards}.ball-white{background:#fff}.ball-blue{background:#38bdf8}.ball-green{background:#4ade80}.ball-yellow{background:#fde047}.ball-red{background:#f43f5e}.ball-copper{background:#c2410c}.ball-silver{background:#cbd5e1}.ball-gold{background:#fbbf24}
    .garagara-drum { width:8.75rem; height:8.75rem; display:grid; place-items:center; border:12px solid #b7791f; border-radius:50%; background:repeating-conic-gradient(#f7d794 0 12deg,#d69e2e 12deg 24deg); box-shadow:0 9px 0 #78350f, inset 0 0 0 8px rgba(255,255,255,.08); animation:drum-turn 1.2s linear infinite; position:relative; }
    .garagara-drum span { position:absolute; width:.9rem; height:1.7rem; background:#fffaf0; border-radius:.35rem; box-shadow:0 0 0 .15rem rgba(120,53,15,.18); }
    .garagara-drum span:nth-child(1) { transform:rotate(15deg) translateY(-2.8rem); }
    .garagara-drum span:nth-child(2) { transform:rotate(105deg) translateY(-2.8rem); }
    .garagara-drum span:nth-child(3) { transform:rotate(195deg) translateY(-2.8rem); }
    .garagara-drum span:nth-child(4) { transform:rotate(285deg) translateY(-2.8rem); }
    .garagara-rain { position:absolute; inset:-.5rem 0 auto; display:flex; justify-content:center; gap:1rem; pointer-events:none; }
    .garagara-rain span { width:.65rem; height:1.8rem; background:linear-gradient(180deg, rgba(255,255,255,.9), rgba(255,247,237,.15)); border-radius:999px; animation:rain-fall 1.1s linear infinite; }
    .garagara-rain span:nth-child(2) { animation-delay:.18s; }
    .garagara-rain span:nth-child(3) { animation-delay:.36s; }
    .animation-money-box .moneybox-stage { width:min(24rem, 76vw); height:12rem; display:grid; place-items:center; position:relative; }
    .money-box { width:8rem; height:7.5rem; display:grid; place-items:center; color:#fbbf24; font-size:6rem; position:relative; animation:money-box-bounce 1s ease-in-out infinite alternate; }
    .money-box::before { content:""; position:absolute; inset:1.15rem 1rem 0.75rem; border-radius:1rem 1rem .85rem .85rem; background:linear-gradient(180deg,#5b21b6,#312e81); box-shadow:0 8px 0 #111827, inset 0 0 0 4px rgba(251,191,36,.4); }
    .money-box-slot { position:absolute; top:1.1rem; width:2.2rem; height:.5rem; border-radius:999px; background:#fef3c7; z-index:1; box-shadow:0 0 .7rem rgba(254,243,199,.95); }
    .money-box-face { position:absolute; bottom:1.05rem; width:3.5rem; height:.75rem; border-radius:999px; background:linear-gradient(90deg,#fef3c7,#fbbf24,#fef3c7); z-index:1; }
    .coin { position:absolute; color:#fde047; font-size:2.8rem; text-shadow:0 0 16px rgba(253,224,71,.8); }
    .coin-1 { left:2rem; top:1rem; animation:coin-drop-left 1.2s ease-in infinite; }
    .coin-2 { left:50%; top:-.2rem; transform:translateX(-50%); animation:coin-drop-center 1.2s ease-in .15s infinite; }
    .coin-3 { right:2rem; top:1.1rem; animation:coin-drop-right 1.2s ease-in .3s infinite; }
    .fortune-slip { position:absolute; right:0; bottom:-.25rem; padding:.6rem 1rem; color:#5b1d12; background:#fff7ed; font-size:1rem; font-weight:900; border-radius:.4rem; box-shadow:0 0 18px rgba(255,247,237,.75); writing-mode:vertical-rl; animation:slip-pop .85s .35s both; }
    .animation-scratch-card .scratch-stage { width:min(30rem,86vw); height:14rem; display:grid; place-items:center; position:relative; }
    .scratch-card { width:min(28rem,82vw); height:12rem; position:relative; display:grid; place-items:center; overflow:hidden; border:6px solid #fbbf24; border-radius:1.15rem; background:linear-gradient(135deg,#4c1d95,#be185d 54%,#f59e0b); box-shadow:0 .8rem 1.8rem rgba(0,0,0,.38),inset 0 0 0 3px rgba(255,255,255,.25); }
    .scratch-card-heading { position:absolute; top:.7rem; left:0; right:0; z-index:1; color:#fef3c7; font-size:clamp(.7rem,1.8vw,1rem); font-weight:950; letter-spacing:.24em; }
    .scratch-card-result { z-index:1; max-width:82%; color:#fff; font-size:clamp(1.7rem,5.6vw,3.8rem); font-weight:950; line-height:1.15; overflow-wrap:anywhere; text-shadow:0 4px 16px rgba(20,8,43,.78); }
    .scratch-silver { position:absolute; inset:2.3rem 1.1rem 1.15rem; z-index:2; border:2px solid rgba(255,255,255,.72); border-radius:.7rem; background:repeating-linear-gradient(112deg,#9ca3af 0 .35rem,#e5e7eb .35rem .7rem,#6b7280 .7rem 1.05rem,#d1d5db 1.05rem 1.45rem); box-shadow:inset 0 0 1.1rem rgba(255,255,255,.78),0 0 .7rem rgba(255,255,255,.42); animation:silver-scratch var(--draw-duration) cubic-bezier(.15,.75,.3,1) forwards; }
    .scratch-silver::after { content:""; position:absolute; inset:0; background:repeating-linear-gradient(18deg,transparent 0 1rem,rgba(30,41,59,.32) 1.05rem 1.2rem,transparent 1.25rem 2.1rem); animation:scratch-grooves var(--draw-duration) linear forwards; }
    .scratch-brush { position:absolute; z-index:3; width:2.7rem; height:2.7rem; border:5px solid rgba(255,255,255,.96); border-radius:50%; box-shadow:0 0 0 .35rem rgba(71,85,105,.6),0 .3rem .7rem rgba(0,0,0,.35); background:radial-gradient(circle at 35% 30%,#fff,#cbd5e1 48%,#64748b 52%); animation:scratch-brush-path var(--draw-duration) ease-in-out forwards; }
    .scratch-spark { position:absolute; z-index:4; width:.45rem; height:.45rem; border-radius:50%; background:#e5e7eb; box-shadow:0 0 .6rem #fff; opacity:0; animation:scratch-spark var(--draw-duration) ease-out forwards; }.scratch-spark-one{left:28%;top:38%}.scratch-spark-two{right:24%;top:53%;animation-delay:calc(var(--draw-duration) * .08)}.scratch-spark-three{left:48%;bottom:18%;animation-delay:calc(var(--draw-duration) * .16)}
    .grand-prize { animation:grand-flash .8s ease-in-out infinite alternate, grand-scale 1.4s ease-in-out infinite alternate; }
    .grand-prize::after { content:""; position:absolute; inset:-4rem; pointer-events:none; background:conic-gradient(from 0deg, transparent 0 15%, rgba(255,255,255,.55) 20%, transparent 25% 40%, rgba(251,191,36,.55) 45%, transparent 50% 65%, rgba(255,255,255,.45) 70%, transparent 75% 100%); mask:radial-gradient(circle, transparent 0 38%, #000 52%); animation:grand-spin 3.5s linear infinite; }
    .grand-prize-banner { color:#fff7d6; font-size:clamp(1.2rem,3vw,2.3rem); font-weight:950; letter-spacing:.2em; text-shadow:0 0 24px rgba(255,240,140,.9); }
    .donate-reveal-label { max-width:100%; color:#ffd166; font-weight:900; letter-spacing:.16em; overflow-wrap:anywhere; }
    .donate-result-content { width:min(92vw,38rem); display:grid; justify-items:center; gap:clamp(.4rem,1vh,.7rem); }
    .donate-reveal-image { display:block; width:auto; max-width:min(78vw,32rem); height:auto; max-height:min(28vh,16rem); object-fit:contain; border:5px solid var(--polaroid-accent,#ffd166); border-radius:1rem; box-shadow:0 0 38px color-mix(in srgb,var(--polaroid-accent,#ffd166) 80%,transparent); }
    .donate-reveal-fallback { width:min(78vw,32rem); min-height:clamp(7rem,16vh,11rem); padding:clamp(1rem,3vw,2rem); box-sizing:border-box; display:grid; place-items:center; border:5px solid var(--polaroid-accent,#ffd166); border-radius:1rem; background:var(--polaroid-surface,linear-gradient(135deg,#6d28d9,#f59e0b)); font-size:clamp(1.8rem,5vw,3.5rem); font-weight:900; line-height:1.2; overflow-wrap:anywhere; }
    .donate-reveal-prize { max-width:100%; font-size:clamp(1.6rem,4vw,3rem); font-weight:900; line-height:1.2; overflow-wrap:anywhere; }
    .donate-reveal-congratulation { max-width:100%; margin:0 auto; color:var(--polaroid-accent,#ffd166); font-size:clamp(.95rem,2.1vw,1.35rem); font-weight:800; line-height:1.4; overflow-wrap:anywhere; }
    .donate-test-panel { position:fixed; right:1rem; bottom:1rem; z-index:10; max-width:24rem; padding:1rem; border-radius:.75rem; background:#fff; color:#172033; box-shadow:0 8px 30px rgba(0,0,0,.35); }
    .donate-test-panel-header { display:flex; justify-content:space-between; align-items:center; }
    .donate-test-panel input { display:block; width:100%; margin:.5rem 0; padding:.45rem; }
    .donate-test-panel button { padding:.45rem .75rem; border:0; border-radius:.35rem; background:#2563eb; color:#fff; }
    .donate-test-close { font-size:1.25rem; line-height:1; }
    .donate-test-launch { position:fixed; right:1rem; bottom:1rem; z-index:10; padding:.75rem 1rem; border:0; border-radius:.5rem; background:#2563eb; color:#fff; font-weight:800; box-shadow:0 6px 20px rgba(0,0,0,.35); }
    @@media (max-width:46rem) {
        .donate-reveal { width:100%; padding:.75rem .5rem; }
        .donate-reveal-image { max-width:82vw; max-height:27vh; }
        .donate-reveal-fallback { width:82vw; }
    }
    @@media (prefers-reduced-motion:reduce) {
        .donate-reveal, .donate-reveal *, .donate-reveal::before, .donate-reveal::after { animation:none !important; }
    }
    @@keyframes donate-reveal { from { opacity:0; transform:scale(.45) rotate(-4deg); } to { opacity:1; transform:scale(1) rotate(0); } }
    @@keyframes notice-pop{from{opacity:0;transform:translateY(2rem) scale(.85)}to{opacity:1;transform:none}}@@keyframes box-shake{50%{transform:rotate(2deg)}}@@keyframes tear-left{0%,65%{transform:translateX(0)}100%{transform:translateX(-7rem) rotate(-22deg);opacity:0}}@@keyframes tear-right{0%,65%{transform:translateX(0)}100%{transform:translateX(7rem) rotate(22deg);opacity:0}}@@keyframes ball-drop{0%,72%{transform:translateY(-8rem) scale(.2);opacity:0}82%{opacity:1}100%{transform:translateY(0) scale(1);opacity:1}}
    @@keyframes curtain-open-left { from { transform:scaleX(1); } to { transform:scaleX(.82) rotate(-1.5deg); } }
    @@keyframes curtain-open-right { from { transform:scaleX(1); } to { transform:scaleX(.82) rotate(1.5deg); } }
    @@keyframes shine-sweep { from { filter:brightness(1); transform:translateX(-10%); } to { filter:brightness(1.45); transform:translateX(10%); } }
    @@keyframes ticket-reveal { from { transform:scale(.2) rotate(25deg) translateY(1.5rem); } to { transform:scale(1) rotate(-6deg) translateY(0); } }
    @@keyframes ticket-bob { from { transform:rotate(-7deg) translateY(-.15rem); } to { transform:rotate(-5deg) translateY(.25rem); } }
    @@keyframes chibi-pull { from { transform:translateX(0) translateY(0) rotate(0deg); } to { transform:translateX(1rem) translateY(.3rem) rotate(-10deg); } }
    @@keyframes halo-pulse { from { transform:scale(.85); opacity:.7; } to { transform:scale(1.15); opacity:1; } }
    @@keyframes gacha-shake { 50% { transform:translateX(5px) rotate(4deg); } }
    @@keyframes crank-turn { from { transform:rotate(0deg); } to { transform:rotate(360deg); } }
    @@keyframes capsule-drop { from { transform:translateX(-50%) translateY(-1.4rem); opacity:0; } 35%,80% { opacity:1; } to { transform:translateX(-50%) translateY(4.25rem); opacity:0; } }
    @@keyframes chibi-turn-crank { from { transform:translateY(0) rotate(-8deg); } to { transform:translateY(.3rem) rotate(10deg); } }
    @@keyframes arm-turn { from { transform:rotate(-18deg); } to { transform:rotate(28deg); } }
