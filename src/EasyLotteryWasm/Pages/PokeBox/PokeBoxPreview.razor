@page "/pokebox/preview/{Id:int}"
@using EasyLotteryDomain.Models.Entities
@using EasyLotteryDomain.Services
@using EasyLotteryWasm.Models
@using EasyLotteryWasm.Services
@using Serilog

@inject ActivityResultService ActivityResultService
@inject ResultNotificationService ResultNotificationService
@inject PokeService PokeService
@inject NavigationManager NavigationManager
@inject IMessageService MessageService
@inject ObsSessionService ObsSessionService

<PageTitle>戳戳樂 - 預覽</PageTitle>

@if (template == null)
{
    <p>載入中…</p>
}
else
{
    <div class="poke-preview-page">
        <section class="poke-preview-hero">
            <div class="poke-preview-copy">
                <div class="pokebox-eyebrow">POKE BOX PREVIEW</div>
                <h4 class="poke-preview-title mb-0">@template.Name</h4>
                <p class="pokebox-subtitle">在這裡直接測試格子揭露、抽獎記錄和 OBS 來源輸出。</p>
            </div>

            <div class="poke-preview-actions">
                @if (template.Mode == PokeMode.Random)
                {
                    <Button Color="Color.Warning" Clicked="@PokeRandom">隨機戳一格</Button>
                }
                <Button Color="Color.Success" Clicked="@EndActivityAndRecord" Disabled="@(!CanRecordCurrentActivity || isRecording)">
                    @(isRecording ? "記錄中…" : "結束本次活動並記錄")
                </Button>
                <Button Color="Color.Danger" Clicked="@ResetTemplate">重設</Button>
                <Button Color="Color.Light" Clicked="@GoBack">返回</Button>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(template.CongratulationMessage))
        {
            <div class="poke-congrats-banner mb-3">
                @template.CongratulationMessage
            </div>
        }

        <section class="poke-preview-stage" style="@PreviewWrapperStyle">
            <LiveDrawFlowGuide Title="戳戳樂流程"
                               Subtitle="@template.Name"
                               Phase="@flowPhase"
                               CountdownRemaining="@countdownRemaining"
                               DetailText="@FlowDetailText" />

            <div class="poke-preview-counter">
                已戳：@RevealedCount / @template.Cells.Count
                @if (template.MaxPokeCount > 0)
                {
                    <span>（上限：@template.MaxPokeCount）</span>
                }
            </div>

            <div class="poke-grid poke-grid-preview" style="@GridStyle">
                @foreach (var cell in template.Cells.OrderBy(c => c.Index))
                {
                    <div class="poke-cell @(cell.IsRevealed ? "revealed " + AnimationClass : "") @(lastPokedIndex == cell.Index ? "just-poked" : "")"
                         style="@CellStyle(cell)"
                         @onclick="@(() => OnCellClick(cell))">
                        @if (cell.IsRevealed)
                        {
                            @if (!string.IsNullOrEmpty(cell.RevealedImageUrl))
                            {
                                <img src="@cell.RevealedImageUrl" alt="@cell.Title" style="max-width:100%;max-height:80%;" />
                            }
                            <div class="cell-title">@cell.Title</div>
                            @if (!string.IsNullOrEmpty(cell.SubTitle))
                            {
                                <div class="cell-subtitle">@cell.SubTitle</div>
                            }
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(cell.ImageUrl))
                            {
                                <img src="@cell.ImageUrl" alt="@cell.Title" style="max-width:100%;max-height:80%;" />
                            }
                            else
                            {
                                <span class="poke-icon">👆</span>
                            }
                        }
                    </div>
                }
            </div>
        </section>

        <section class="poke-preview-observations">
            <Card class="poke-preview-card">
                <CardHeader>
                    <CardTitle>OBS 瀏覽器來源（固定網址）</CardTitle>
                </CardHeader>
                <CardBody>
                    <p class="obs-source-guide-title">這是固定的 OBS 來源網址，設定一次後就可以長期使用。</p>
                    <p class="obs-source-guide-body">在 OBS 新增「瀏覽器」來源，直接貼上下面網址：</p>
                    <code class="obs-source-code">@ObsUrl</code>
                    <ul class="obs-source-list">
                        <li>建議依格數調整大小，例如 <strong>3 × 3 建議 500 × 550</strong></li>
                        <li>勾選「關閉時使場景不活躍」</li>
                        <li>背景已預設透明，可直接疊加在直播場景上</li>
                    </ul>
                </CardBody>
            </Card>
        </section>
    </div>
}

<style>
    .poke-preview-wrapper {
        padding: 16px;
        border-radius: 8px;
        min-height: 400px;
        color: var(--el-text);
    }

    .poke-grid {
        gap: 8px;
    }

    .poke-congrats-banner {
        display: inline-flex;
        align-items: center;
        max-width: 100%;
        padding: 12px 16px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--el-accent) 24%, var(--el-surface-strong));
        color: var(--el-text);
        font-weight: 700;
        letter-spacing: 0.04em;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
    }
    .poke-cell {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        cursor: pointer;
        min-height: 80px;
        font-size: 0.85rem;
        text-align: center;
        padding: 4px;
        transition: transform 0.2s, box-shadow 0.2s;
        background: var(--el-surface-strong);
        color: var(--el-text);
        border: 2px solid var(--el-border-strong);
        user-select: none;
    }

    .poke-cell:hover:not(.revealed) {
        transform: scale(1.05);
        box-shadow: 0 0 12px var(--el-glow);
    }

    .poke-cell.revealed {
        cursor: default;
    }

    .poke-cell .poke-icon {
        font-size: 1.8rem;
    }

    .poke-cell .cell-title {
        font-weight: bold;
        margin-top: 4px;
    }

    .poke-cell .cell-subtitle {
        font-size: 0.75rem;
        opacity: 0.8;
    }

    .obs-source-guide {
        background: var(--el-surface-soft);
        border-radius: 10px;
        border: 1px solid var(--el-border);
    }

    .obs-source-guide-title {
        color: var(--el-text);
        font-weight: 700;
        margin-bottom: 8px;
    }

    .obs-source-guide-body {
        color: var(--el-text-muted);
        font-size: 0.9rem;
        margin-bottom: 8px;
    }

    .obs-source-code {
        display: block;
        color: var(--el-accent);
        word-break: break-all;
        padding: 10px 12px;
        border-radius: 8px;
        background: color-mix(in srgb, var(--el-surface-strong) 82%, transparent);
        border: 1px solid var(--el-border);
    }

    .obs-source-list {
        margin: 10px 0 0;
        padding-left: 20px;
        color: var(--el-text-muted);
        font-size: 0.85rem;
        line-height: 1.6;
    }

    .poke-preview-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .poke-preview-stage {
        position: relative;
        padding: 20px;
        border-radius: 24px;
        border: 1px solid var(--el-border);
        background: var(--el-stage-bg);
        box-shadow: var(--el-shadow);
        overflow: hidden;
    }

    .poke-preview-stage::before {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--el-stage-overlay);
        pointer-events: none;
    }

    .poke-preview-stage > * {
        position: relative;
        z-index: 1;
    }

    .poke-preview-counter {
        margin-bottom: 12px;
        color: var(--el-text-muted);
        font-weight: 600;
    }

    .poke-grid-preview {
        gap: 10px;
    }

    .poke-preview-observations {
        display: grid;
    }

    .poke-preview-card {
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid var(--el-border);
        background: rgba(255, 255, 255, 0.96);
        box-shadow: var(--el-shadow);
    }

    .poke-preview-card ::deep .card-header {
        background: linear-gradient(180deg, rgba(248, 250, 253, 0.98), rgba(237, 242, 249, 0.98));
    }

    .obs-source-guide-title {
        color: var(--el-text);
        font-weight: 700;
        margin-bottom: 8px;
    }

    .obs-source-guide-body {
        color: var(--el-text-muted);
        font-size: 0.9rem;
        margin-bottom: 8px;
    }

    @@media (max-width: 767.98px) {
        .poke-preview-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .poke-preview-actions {
            justify-content: flex-start;
        }
    }

    /* Animation classes */
    .poke-cell.just-poked.anim-burst {
        animation: burst 0.5s ease-out;
    }

    .poke-cell.just-poked.anim-bounce {
        animation: bounce 0.5s ease-out;
    }

    .poke-cell.just-poked.anim-flash {
        animation: flash 0.5s ease-out;
    }

    .poke-cell.just-poked.anim-smoke {
        animation: smoke 0.6s ease-out;
    }

    .poke-cell.just-poked.anim-flip {
        animation: flip 0.5s ease-out;
    }

    @@keyframes burst {
        0% { transform: scale(1); }
        30% { transform: scale(1.4); }
        60% { transform: scale(0.9); }
        100% { transform: scale(1); }
    }

    @@keyframes bounce {
        0%, 100% { transform: translateY(0); }
        30% { transform: translateY(-16px); }
        60% { transform: translateY(-8px); }
    }

    @@keyframes flash {
        0%, 100% { opacity: 1; box-shadow: none; }
        50% { opacity: 0.5; box-shadow: 0 0 24px 8px var(--el-glow); }
    }

    @@keyframes smoke {
        0% { opacity: 1; filter: blur(0); }
        50% { opacity: 0.4; filter: blur(4px); }
        100% { opacity: 1; filter: blur(0); }
    }

    @@keyframes flip {
        0% { transform: rotateY(0); }
        50% { transform: rotateY(90deg); }
        100% { transform: rotateY(0); }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private PokeTemplate? template;
    private int? lastPokedIndex;
    private LiveDrawPhase flowPhase = LiveDrawPhase.Ready;
    private int? countdownRemaining;
    private bool isRecording;
    private string? lastRecordedSignature;
    private string sessionToken = "";

    // Longest CSS animation is 600ms (smoke); wait slightly longer before clearing the class
    private const int AnimationDurationMs = 650;
    private const int RevealCountdownSeconds = 2;
    private const int RevealHoldMs = 450;

    private int RevealedCount => template?.Cells.Count(c => c.IsRevealed) ?? 0;
    private bool CanRecordCurrentActivity => template != null && RevealedCount > 0 && BuildRecordSignature() != lastRecordedSignature;
    private bool IsBusy => countdownRemaining.HasValue || flowPhase == LiveDrawPhase.CountingDown || flowPhase == LiveDrawPhase.Spinning;

    private string FlowDetailText => flowPhase switch
    {
        LiveDrawPhase.Ready => "按下戳選後會先進入倒數，再揭露結果。",
        LiveDrawPhase.CountingDown => "倒數中，請準備看揭露動畫。",
        LiveDrawPhase.Spinning => "畫面正在展示戳戳樂過場。",
        LiveDrawPhase.ShowingResult when RevealedCount >= (template?.Cells.Count ?? 0) => "本次戳戳樂已全部完成。",
        LiveDrawPhase.ShowingResult => "目前結果已顯示，可繼續戳下一格。",
        _ => "戳戳樂流程已就緒。"
    };

    private string PreviewWrapperStyle =>
        string.IsNullOrEmpty(template?.BackgroundImageUrl)
            ? "background:var(--el-stage-bg);"
            : $"background:linear-gradient(135deg, rgba(0,0,0,0.2), rgba(0,0,0,0.5)), url('{template.BackgroundImageUrl}') center/cover;";

    private string GridStyle =>
        $"display:grid;grid-template-columns:repeat({template?.GridColumns ?? 3},1fr);gap:8px;";

    private string AnimationClass => template?.Animation switch
    {
        PokeAnimation.Burst => "anim-burst",
        PokeAnimation.Bounce => "anim-bounce",
        PokeAnimation.Flash => "anim-flash",
        PokeAnimation.Smoke => "anim-smoke",
        PokeAnimation.Flip => "anim-flip",
        _ => "anim-burst"
    };

    private string CellStyle(PokeCell cell)
    {
        if (cell.IsRevealed)
        {
            var bg = string.IsNullOrEmpty(cell.RevealedColor) ? "#cccccc" : cell.RevealedColor;
            return $"background:{bg};color:var(--el-accent-contrast);border-color:{bg};";
        }
        return "";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplate();
        if (template is { PublicId: var publicId } && publicId != Guid.Empty)
            sessionToken = await ObsSessionService.CreateObsTokenAsync("pokebox", publicId.ToString(), true);
    }

    private async Task LoadTemplate()
    {
        template = await PokeService.LoadTemplateAsync(Id);
        if (template == null)
        {
            await MessageService.Error("找不到模板。");
            NavigationManager.NavigateTo("/pokebox");
        }
    }

    private async Task OnCellClick(PokeCell cell)
    {
        if (template == null) return;
        if (template.Mode != PokeMode.Manual) return;
        if (cell.IsRevealed && !template.AllowRePoking) return;

        await RunRevealSequenceAsync(() => PokeService.PokeCellByIndexAsync(template.Id, cell.Index), poked =>
        {
            cell.IsRevealed = true;
            cell.RevealedAt = poked.RevealedAt;
            lastPokedIndex = cell.Index;
        });
    }

    private async Task PokeRandom()
    {
        if (template == null) return;

        await RunRevealSequenceAsync(() => PokeService.PokeRandomCellAsync(template.Id), poked =>
        {
            var cell = template.Cells.FirstOrDefault(c => c.Index == poked.Index);
            if (cell != null)
            {
                cell.IsRevealed = true;
                cell.RevealedAt = poked.RevealedAt;
                lastPokedIndex = cell.Index;
            }
        });
    }

    private async Task ResetTemplate()
    {
        if (template == null) return;
        await PokeService.ResetTemplateAsync(template.Id);
        lastPokedIndex = null;
        lastRecordedSignature = null;
        await LoadTemplate();
    }

    private async Task EndActivityAndRecord()
    {
        if (template == null || !CanRecordCurrentActivity || isRecording || IsBusy) return;

        isRecording = true;
        try
        {
            var record = await ActivityResultService.RecordPokeActivityAsync(template.Id);
            lastRecordedSignature = BuildRecordSignature();
            await ResultNotificationService.NotifyActivityResultAsync(record);
            await MessageService.Success($"已記錄活動「{record.ActivityName}」結果。");
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to record poke activity result in preview.");
            await MessageService.Error(ex.Message);
        }
        finally
        {
            isRecording = false;
        }
    }

    private async Task ClearAnimationAfterDelay()
    {
        await Task.Delay(AnimationDurationMs);
        lastPokedIndex = null;
        StateHasChanged();
    }

    private async Task RunRevealSequenceAsync(Func<Task<PokeCell?>> revealAsync, Action<PokeCell> applyReveal)
    {
        if (template == null || IsBusy)
        {
            return;
        }

        flowPhase = LiveDrawPhase.CountingDown;
        countdownRemaining = RevealCountdownSeconds;
        await MessageService.Info("倒數開始，準備揭露戳戳樂。");
        StateHasChanged();

        while (countdownRemaining > 0)
        {
            await Task.Delay(1000);
            countdownRemaining--;
            StateHasChanged();
        }

        flowPhase = LiveDrawPhase.Spinning;
        countdownRemaining = null;
        StateHasChanged();

        await Task.Delay(220);
        var poked = await revealAsync();
        if (poked == null)
        {
            flowPhase = LiveDrawPhase.Ready;
            await MessageService.Info("所有格子已全部開啟！");
            StateHasChanged();
            return;
        }

        applyReveal(poked);
        flowPhase = LiveDrawPhase.ShowingResult;
        StateHasChanged();

        await Task.Delay(RevealHoldMs);
        await ClearAnimationAfterDelay();
        flowPhase = LiveDrawPhase.Ready;
        StateHasChanged();
    }

    private string ObsUrl => string.IsNullOrWhiteSpace(sessionToken)
        ? NavigationManager.ToAbsoluteUri($"/obs/pokebox/{Id}").ToString()
        : $"{NavigationManager.ToAbsoluteUri($"/obs/pokebox/{Id}").ToString()}#sessionToken={Uri.EscapeDataString(sessionToken)}";

    private string BuildRecordSignature()
    {
        if (template == null)
        {
            return "";
        }

        return string.Join(
            '|',
            template.Cells
                .Where(cell => cell.IsRevealed)
                .OrderBy(cell => cell.Index)
                .Select(cell => $"{cell.Id}:{cell.RevealedAt?.Ticks ?? 0}"));
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/pokebox");
    }
}
