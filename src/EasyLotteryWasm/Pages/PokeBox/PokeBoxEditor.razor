@page "/pokebox/editor/{Id:int}"
@using EasyLotteryDomain.Models.Entities
@using EasyLotteryDomain.Services

@inject PokeService PokeService
@inject NavigationManager NavigationManager
@inject IMessageService MessageService

<PageTitle>戳戳樂 - 編輯器</PageTitle>

<div class="pokebox-editor-page">
    <section class="pokebox-editor-hero">
        <div class="pokebox-editor-copy">
            <div class="pokebox-eyebrow">POKE BOX STUDIO</div>
            <h3 class="pokebox-editor-title">@(Id == 0 ? "新增模板" : "編輯模板")</h3>
            <p class="pokebox-subtitle">把模板設定和格子內容分成兩欄，調整時會更像在編輯一個正式的活動面板。</p>
        </div>

        <div class="pokebox-editor-actions">
            <Badge Color="@(template == null ? Color.Secondary : (template.PublicationStatus == TemplatePublicationStatus.Draft ? Color.Warning : Color.Success))">
                @if (template == null)
                {
                    <span>載入中</span>
                }
                else
                {
                    @(template.PublicationStatus == TemplatePublicationStatus.Draft ? "目前為草稿" : "目前已發布")
                }
            </Badge>
            <Button Color="Color.Light" Clicked="@GoBack">返回</Button>
        </div>
    </section>

    @if (template == null)
    {
        <div class="pokebox-state-panel">載入中…</div>
    }
    else
    {
        <section class="pokebox-editor-toolbar pokebox-editor-toolbar-top">
            <Button Color="Color.Primary" Clicked="@SaveDraft">儲存草稿</Button>
            <Button Color="Color.Success" Clicked="@Publish">發布</Button>
            <Button Color="Color.Secondary" Clicked="@ApplyGrid">套用格數（重設格子）</Button>
        </section>

        <section class="pokebox-editor-grid">
            <Card class="pokebox-editor-card">
                <CardHeader><CardTitle>全域設定</CardTitle></CardHeader>
                <CardBody>
                    <Field>
                        <FieldLabel>模板名稱</FieldLabel>
                        <TextInput @bind-Value="@template.Name" Placeholder="模板名稱" />
                    </Field>
                    <Field>
                        <FieldLabel>說明</FieldLabel>
                        <TextInput @bind-Value="@template.Description" Placeholder="說明" />
                    </Field>
                    <Field>
                        <FieldLabel>行數</FieldLabel>
                        <NumericInput TValue="int" @bind-Value="@template.GridRows" Min="1" Max="10" />
                    </Field>
                    <Field>
                        <FieldLabel>欄數</FieldLabel>
                        <NumericInput TValue="int" @bind-Value="@template.GridColumns" Min="1" Max="10" />
                    </Field>
                    <Field>
                        <FieldLabel>戳擊模式</FieldLabel>
                        <select class="form-select" @bind="@template.Mode">
                            <option value="@PokeMode.Random">隨機</option>
                            <option value="@PokeMode.Manual">手動</option>
                        </select>
                    </Field>
                    <Field>
                        <FieldLabel>允許重複戳</FieldLabel>
                        <Switch TValue="bool" @bind-Value="@template.AllowRePoking" />
                    </Field>
                    <Field>
                        <FieldLabel>次數限制（0=無限）</FieldLabel>
                        <NumericInput TValue="int" @bind-Value="@template.MaxPokeCount" Min="0" />
                    </Field>
                    <Field>
                        <FieldLabel>動畫效果</FieldLabel>
                        <select class="form-select" @bind="@template.Animation">
                            <option value="@PokeAnimation.Burst">爆破</option>
                            <option value="@PokeAnimation.Smoke">煙霧</option>
                            <option value="@PokeAnimation.Flash">光芒</option>
                            <option value="@PokeAnimation.Bounce">彈跳</option>
                            <option value="@PokeAnimation.Flip">翻轉</option>
                        </select>
                    </Field>
                    <Field>
                        <FieldLabel>動畫秒數</FieldLabel>
                        <NumericInput TValue="int" @bind-Value="@template.AnimationDurationMs" Min="300" Max="10000" />
                        <div class="form-text">300–10000 毫秒</div>
                    </Field>
                    <Field>
                        <FieldLabel>結果停留秒數</FieldLabel>
                        <NumericInput TValue="int" @bind-Value="@template.ResultDisplayDurationSeconds" Min="1" Max="300" />
                        <div class="form-text">結束後回到透明待機</div>
                    </Field>
                    <Field>
                        <FieldLabel>字體</FieldLabel>
                        <TextInput @bind-Value="@template.FontFamily" Placeholder="例如：Arial" />
                    </Field>
                    <Field>
                        <FieldLabel>背景圖片 URL</FieldLabel>
                        <TextInput @bind-Value="@template.BackgroundImageUrl" Placeholder="https://…" />
                    </Field>
                    <Field>
                        <FieldLabel>恭喜語句</FieldLabel>
                        <TextInput @bind-Value="@template.CongratulationMessage" Placeholder="例如：恭喜中獎，請保持聯絡！" />
                    </Field>
                    <Field>
                        <FieldLabel>Overlay 寬度</FieldLabel>
                        <NumericInput TValue="int" @bind-Value="@template.OverlayWidth" Min="320" Max="3840" />
                    </Field>
                    <Field>
                        <FieldLabel>Overlay 高度</FieldLabel>
                        <NumericInput TValue="int" @bind-Value="@template.OverlayHeight" Min="240" Max="2160" />
                    </Field>
                </CardBody>
            </Card>

            <Card class="pokebox-editor-card pokebox-editor-cells">
                <CardHeader><CardTitle>格子設定（共 @template.Cells.Count 格）</CardTitle></CardHeader>
                <CardBody>
                    <div class="poke-grid poke-grid-editor" style="grid-template-columns:repeat(@template.GridColumns, minmax(0, 1fr));">
                        @foreach (var cell in template.Cells.OrderBy(c => c.Index))
                        {
                            <div class="poke-cell-editor border rounded p-2" style="background:@(string.IsNullOrEmpty(cell.RevealedColor)?"#f0f0f0":cell.RevealedColor);">
                                <small><strong>格 @(cell.Index + 1)</strong></small>
                                <Field>
                                    <TextInput @bind-Value="@cell.Title" Placeholder="標題" Size="Size.Small" />
                                </Field>
                                <Field>
                                    <TextInput @bind-Value="@cell.SubTitle" Placeholder="副標" Size="Size.Small" />
                                </Field>
                                <Field>
                                    <TextInput @bind-Value="@cell.ImageUrl" Placeholder="圖片URL" Size="Size.Small" />
                                </Field>
                                <Field>
                                    <TextInput @bind-Value="@cell.RevealedImageUrl" Placeholder="開啟後圖片URL" Size="Size.Small" />
                                </Field>
                                <Field>
                                    <FieldLabel>開啟後顏色</FieldLabel>
                                    <ColorInput @bind-Value="@cell.RevealedColor" />
                                </Field>
                            </div>
                        }
                    </div>
                </CardBody>
            </Card>
        </section>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private PokeTemplate? template;

    protected override async Task OnInitializedAsync()
    {
        if (Id == 0)
        {
            template = new PokeTemplate
            {
                PublicationStatus = TemplatePublicationStatus.Draft
            };
            ApplyGridToTemplate();
        }
        else
        {
            template = await PokeService.LoadTemplateAsync(Id);
            if (template == null)
            {
                await MessageService.Error("找不到模板。");
                NavigationManager.NavigateTo("/pokebox");
            }
        }
    }

    private void ApplyGrid()
    {
        if (template == null) return;
        ApplyGridToTemplate();
    }

    private void ApplyGridToTemplate()
    {
        if (template == null) return;
        var total = template.GridRows * template.GridColumns;
        var current = template.Cells.Count;

        if (current < total)
        {
            for (int i = current; i < total; i++)
            {
                template.Cells.Add(new PokeCell
                {
                    Index = i,
                    Title = $"格子 {i + 1}",
                    RevealedColor = "#cccccc"
                });
            }
        }
        else if (current > total)
        {
            template.Cells = template.Cells
                .OrderBy(c => c.Index)
                .Take(total)
                .ToList();
        }
    }

    private async Task SaveDraft()
    {
        if (template == null) return;
        template.PublicationStatus = TemplatePublicationStatus.Draft;
        await Save();
    }

    private async Task Publish()
    {
        if (template == null) return;
        template.PublicationStatus = TemplatePublicationStatus.Published;
        await Save();
    }

    private async Task Save()
    {
        if (template == null) return;
        if (string.IsNullOrWhiteSpace(template.Name))
        {
            await MessageService.Warning("請輸入模板名稱。");
            return;
        }

        // Ensure cell indices are sequential
        var sorted = template.Cells.OrderBy(c => c.Index).ToList();
        for (int i = 0; i < sorted.Count; i++) sorted[i].Index = i;
        template.Cells = sorted;

        if (template.Id == 0)
        {
            await PokeService.CreateTemplateAsync(template);
        }
        else
        {
            await PokeService.UpdateTemplateAsync(template);
        }

        await MessageService.Success("儲存成功！");
        NavigationManager.NavigateTo("/pokebox", forceLoad: true);
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/pokebox");
    }
}
