@page "/obs/pokebox/{Id:int}"
@layout ObsLayout
@using EasyLotteryDomain.Models.Entities
@using EasyLotteryDomain.Services
@using EasyLotteryWasm.Layout

@inject ActivityResultService ActivityResultService
@inject PokeService PokeService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>戳戳樂 - OBS</PageTitle>

@if (isLoading)
{
    <div class="obs-state">
        <div class="obs-state-title">載入中…</div>
    </div>
}
else if (template == null)
{
    <div class="obs-state obs-state-error">
        <div class="obs-state-title">找不到戳戳樂模板</div>
        <div class="obs-state-hint">這個 OBS 連結對應的模板不存在，或頁面重新載入後只保留預設模板。</div>
    </div>
}
else
{
    <div class="obs-poke-wrapper" style="@WrapperStyle">
        <div class="obs-topbar">
            <div class="obs-topbar-copy">
                <div class="obs-topbar-eyebrow">OBS CONTROL</div>
                <div class="obs-topbar-title">戳戳樂控制台</div>
                <div class="obs-topbar-subtitle">@template.Name</div>
            </div>
            <div class="obs-topbar-actions">
                <button class="obs-secondary-btn" @onclick="@CopyObsUrlAsync">複製來源網址</button>
                <button class="obs-secondary-btn" @onclick="@LoadTemplate">重新載入模板</button>
            </div>
        </div>

        <div class="obs-status-panel">
            <div class="obs-status-pill">模式：@(template.Mode == PokeMode.Random ? "隨機" : "手動")</div>
            <div class="obs-status-pill">已戳：@RevealedCount / @template.Cells.Count</div>
            @if (template.MaxPokeCount > 0)
            {
                <div class="obs-status-pill">上限：@template.MaxPokeCount</div>
            }
            <div class="obs-status-pill">來源：@ObsUrl</div>
        </div>

        <div class="poke-grid" style="@GridStyle">
            @foreach (var cell in template.Cells.OrderBy(c => c.Index))
            {
                <div class="poke-cell @(cell.IsRevealed ? "revealed " + AnimationClass : "") @(lastPokedIndex == cell.Index ? "just-poked" : "")"
                     style="@CellStyle(cell)"
                     @onclick="@(() => OnCellClick(cell))">
                    @if (cell.IsRevealed)
                    {
                        @if (!string.IsNullOrEmpty(cell.RevealedImageUrl))
                        {
                            <img src="@cell.RevealedImageUrl" alt="@cell.Title" style="max-width:100%;max-height:80%;" />
                        }
                        <div class="cell-title">@cell.Title</div>
                        @if (!string.IsNullOrEmpty(cell.SubTitle))
                        {
                            <div class="cell-subtitle">@cell.SubTitle</div>
                        }
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(cell.ImageUrl))
                        {
                            <img src="@cell.ImageUrl" alt="@cell.Title" style="max-width:100%;max-height:80%;" />
                        }
                        else
                        {
                            <span class="poke-icon">👆</span>
                        }
                    }
                </div>
            }
        </div>

        <div class="obs-controls">
            @if (template.Mode == PokeMode.Random)
            {
                <button class="obs-poke-btn" @onclick="@PokeRandom">隨機戳一格</button>
            }
            <button class="obs-record-btn" @onclick="@EndActivityAndRecord" disabled="@(!CanRecordCurrentActivity || isRecording)">
                @(isRecording ? "記錄中…" : "結束本次活動並記錄")
            </button>
            <button class="obs-reset-btn" @onclick="@ResetTemplate">重設</button>
        </div>

        <div class="obs-status">
            已戳：@RevealedCount / @template.Cells.Count
            @if (template.MaxPokeCount > 0)
            {
                <span>（上限：@template.MaxPokeCount）</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="obs-feedback @(statusIsError ? "obs-feedback-error" : "obs-feedback-success")">@statusMessage</div>
        }
    </div>
}

<style>
    /* OBS 透明背景 */
    html, body, #app, .obs-layout {
        background: transparent !important;
        margin: 0;
        padding: 0;
    }

    .obs-poke-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 16px;
        gap: 12px;
    }

    .obs-topbar,
    .obs-status-panel {
        width: min(100%, 960px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        padding: 12px 16px;
        border-radius: 16px;
        background: rgba(15, 23, 42, 0.78);
        color: white;
        box-shadow: 0 18px 48px rgba(0, 0, 0, 0.22);
    }

    .obs-topbar-eyebrow {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        opacity: 0.7;
    }

    .obs-topbar-title {
        margin-top: 2px;
        font-size: 1.08rem;
        font-weight: 800;
    }

    .obs-topbar-subtitle {
        margin-top: 2px;
        font-size: 0.92rem;
        opacity: 0.82;
    }

    .obs-topbar-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .obs-secondary-btn {
        background: rgba(255, 255, 255, 0.12);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 8px;
        padding: 10px 16px;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s, transform 0.2s;
    }

    .obs-secondary-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        transform: translateY(-1px);
    }

    .obs-status-panel {
        justify-content: flex-start;
    }

    .obs-status-pill {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.12);
        font-size: 0.88rem;
        font-weight: 700;
        word-break: break-all;
    }

    .obs-state {
        min-width: 320px;
        max-width: 520px;
        margin: 24px;
        padding: 20px 24px;
        border-radius: 14px;
        background: rgba(15, 23, 42, 0.88);
        color: white;
        text-align: center;
        box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
    }

    .obs-state-error {
        border: 1px solid rgba(248, 113, 113, 0.4);
    }

    .obs-state-title {
        font-size: 1.2rem;
        font-weight: 700;
    }

    .obs-state-hint {
        margin-top: 8px;
        font-size: 0.92rem;
        line-height: 1.5;
        opacity: 0.82;
    }

    .poke-grid {
        gap: 8px;
        width: 100%;
        max-width: 600px;
    }

    .poke-cell {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        cursor: pointer;
        min-height: 80px;
        font-size: 0.85rem;
        text-align: center;
        padding: 4px;
        transition: transform 0.2s, box-shadow 0.2s;
        background: #4a4a6a;
        color: white;
        border: 2px solid #6a6a8a;
        user-select: none;
    }

    .poke-cell:hover:not(.revealed) {
        transform: scale(1.05);
        box-shadow: 0 0 12px rgba(255,255,100,0.6);
    }

    .poke-cell.revealed {
        cursor: default;
    }

    .poke-cell .poke-icon {
        font-size: 1.8rem;
    }

    .poke-cell .cell-title {
        font-weight: bold;
        margin-top: 4px;
    }

    .poke-cell .cell-subtitle {
        font-size: 0.75rem;
        opacity: 0.8;
    }

    /* Animation classes */
    .poke-cell.just-poked.anim-burst {
        animation: burst 0.5s ease-out;
    }

    .poke-cell.just-poked.anim-bounce {
        animation: bounce 0.5s ease-out;
    }

    .poke-cell.just-poked.anim-flash {
        animation: flash 0.5s ease-out;
    }

    .poke-cell.just-poked.anim-smoke {
        animation: smoke 0.6s ease-out;
    }

    .poke-cell.just-poked.anim-flip {
        animation: flip 0.5s ease-out;
    }

    @@keyframes burst {
        0% { transform: scale(1); }
        30% { transform: scale(1.4); }
        60% { transform: scale(0.9); }
        100% { transform: scale(1); }
    }

    @@keyframes bounce {
        0%, 100% { transform: translateY(0); }
        30% { transform: translateY(-16px); }
        60% { transform: translateY(-8px); }
    }

    @@keyframes flash {
        0%, 100% { opacity: 1; box-shadow: none; }
        50% { opacity: 0.5; box-shadow: 0 0 24px 8px gold; }
    }

    @@keyframes smoke {
        0% { opacity: 1; filter: blur(0); }
        50% { opacity: 0.4; filter: blur(4px); }
        100% { opacity: 1; filter: blur(0); }
    }

    @@keyframes flip {
        0% { transform: rotateY(0); }
        50% { transform: rotateY(90deg); }
        100% { transform: rotateY(0); }
    }

    .obs-controls {
        margin-top: 12px;
        display: flex;
        gap: 8px;
    }

    .obs-poke-btn {
        background: #f0c040;
        color: #333;
        border: none;
        border-radius: 8px;
        padding: 10px 24px;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    .obs-poke-btn:hover {
        background: #e0b030;
    }

    .obs-reset-btn {
        background: #e74c3c;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 24px;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    .obs-reset-btn:hover {
        background: #c0392b;
    }

    .obs-record-btn {
        background: #27ae60;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 24px;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    .obs-record-btn:hover:not(:disabled) {
        background: #1f8a4d;
    }

    .obs-poke-btn:disabled,
    .obs-record-btn:disabled,
    .obs-reset-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .obs-status {
        margin-top: 8px;
        color: white;
        font-size: 0.9rem;
        opacity: 0.8;
    }

    .obs-feedback {
        margin-top: 10px;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        color: white;
        background: rgba(15, 23, 42, 0.72);
    }

    .obs-feedback-success {
        border: 1px solid rgba(74, 222, 128, 0.5);
    }

    .obs-feedback-error {
        border: 1px solid rgba(248, 113, 113, 0.5);
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private PokeTemplate? template;
    private int? lastPokedIndex;
    private bool isLoading = true;
    private bool isRecording;
    private string? lastRecordedSignature;
    private string? statusMessage;
    private bool statusIsError;

    private const int AnimationDurationMs = 650;

    private int RevealedCount => template?.Cells.Count(c => c.IsRevealed) ?? 0;
    private bool CanRecordCurrentActivity => template != null && RevealedCount > 0 && BuildRecordSignature() != lastRecordedSignature;

    private string WrapperStyle =>
        string.IsNullOrEmpty(template?.BackgroundImageUrl)
            ? ""
            : $"background:url('{template.BackgroundImageUrl}') center/cover;";

    private string GridStyle =>
        $"display:grid;grid-template-columns:repeat({template?.GridColumns ?? 3},1fr);gap:8px;";

    private string AnimationClass => template?.Animation switch
    {
        PokeAnimation.Burst => "anim-burst",
        PokeAnimation.Bounce => "anim-bounce",
        PokeAnimation.Flash => "anim-flash",
        PokeAnimation.Smoke => "anim-smoke",
        PokeAnimation.Flip => "anim-flip",
        _ => "anim-burst"
    };

    private string CellStyle(PokeCell cell)
    {
        if (cell.IsRevealed)
        {
            var bg = string.IsNullOrEmpty(cell.RevealedColor) ? "#cccccc" : cell.RevealedColor;
            return $"background:{bg};color:#333;border-color:{bg};";
        }
        return "";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplate();
    }

    private async Task LoadTemplate()
    {
        template = await PokeService.LoadTemplateAsync(Id);
        if (template == null)
        {
            await PokeService.SeedDefaultTemplatesAsync();
            template = await PokeService.LoadTemplateAsync(Id);
        }

        isLoading = false;
    }

    private string ObsUrl => NavigationManager.ToAbsoluteUri($"/obs/pokebox/{Id}").ToString();

    private async Task CopyObsUrlAsync()
    {
        await JSRuntime.InvokeVoidAsync("easyLotteryClipboard.copyText", ObsUrl);
        SetStatus("已複製 OBS 來源網址。", false);
    }

    private async Task OnCellClick(PokeCell cell)
    {
        if (template == null) return;
        if (template.Mode != PokeMode.Manual) return;
        if (cell.IsRevealed && !template.AllowRePoking) return;

        var poked = await PokeService.PokeCellByIndexAsync(template.Id, cell.Index);
        if (poked != null)
        {
            cell.IsRevealed = true;
            cell.RevealedAt = poked.RevealedAt;
            lastPokedIndex = cell.Index;
            StateHasChanged();
            await ClearAnimationAfterDelay();
        }
    }

    private async Task PokeRandom()
    {
        if (template == null) return;
        var poked = await PokeService.PokeRandomCellAsync(template.Id);
        if (poked == null) return;

        var cell = template.Cells.FirstOrDefault(c => c.Index == poked.Index);
        if (cell != null)
        {
            cell.IsRevealed = true;
            cell.RevealedAt = poked.RevealedAt;
            lastPokedIndex = cell.Index;
            StateHasChanged();
            await ClearAnimationAfterDelay();
        }
    }

    private async Task ResetTemplate()
    {
        if (template == null) return;
        await PokeService.ResetTemplateAsync(template.Id);
        lastPokedIndex = null;
        lastRecordedSignature = null;
        ClearStatus();
        await LoadTemplate();
    }

    private async Task EndActivityAndRecord()
    {
        if (template == null || !CanRecordCurrentActivity || isRecording) return;

        isRecording = true;
        try
        {
            var record = await ActivityResultService.RecordPokeActivityAsync(template.Id);
            lastRecordedSignature = BuildRecordSignature();
            SetStatus($"已記錄活動「{record.ActivityName}」結果。", false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, true);
        }
        finally
        {
            isRecording = false;
        }
    }

    private async Task ClearAnimationAfterDelay()
    {
        await Task.Delay(AnimationDurationMs);
        lastPokedIndex = null;
        StateHasChanged();
    }

    private string BuildRecordSignature()
    {
        if (template == null)
        {
            return "";
        }

        return string.Join(
            '|',
            template.Cells
                .Where(cell => cell.IsRevealed)
                .OrderBy(cell => cell.Index)
                .Select(cell => $"{cell.Id}:{cell.RevealedAt?.Ticks ?? 0}"));
    }

    private void SetStatus(string message, bool isError)
    {
        statusMessage = message;
        statusIsError = isError;
    }

    private void ClearStatus()
    {
        statusMessage = null;
        statusIsError = false;
    }
}
