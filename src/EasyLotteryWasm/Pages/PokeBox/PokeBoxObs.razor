@page "/obs/pokebox/{Id:int}"
@layout ObsLayout
@using EasyLotteryDomain.Models.Entities
@using EasyLotteryDomain.Services
@using EasyLotteryWasm.Layout
@using EasyLotteryWasm.Models
@using Serilog

@inject ActivityResultService ActivityResultService
@inject ResultNotificationService ResultNotificationService
@inject PokeService PokeService
@inject EasyLotteryWasm.Services.SoundCueService SoundCueService

<PageTitle>戳戳樂 - OBS</PageTitle>

@if (isLoading)
{
}
else if (template == null)
{
}
else
{
    <div class="obs-poke-wrapper obs-layout-surface" style="@WrapperStyle">
        <div class="obs-stage">
            <LiveDrawFlowGuide Title="戳戳樂流程"
                               Subtitle="@template.Name"
                               Phase="@flowPhase"
                               CountdownRemaining="@countdownRemaining"
                               DetailText="@FlowDetailText" />

            <div class="poke-grid" style="@GridStyle">
                @foreach (var cell in template.Cells.OrderBy(c => c.Index))
                {
                    <div class="poke-cell @(cell.IsRevealed ? "revealed " + AnimationClass : "") @(lastPokedIndex == cell.Index ? "just-poked" : "")"
                         style="@CellStyle(cell)"
                         @onclick="@(() => OnCellClick(cell))">
                        @if (cell.IsRevealed)
                        {
                            @if (!string.IsNullOrEmpty(cell.RevealedImageUrl))
                            {
                                <img src="@cell.RevealedImageUrl" alt="@cell.Title" style="max-width:100%;max-height:80%;" />
                            }
                            <div class="cell-title">@cell.Title</div>
                            @if (!string.IsNullOrEmpty(cell.SubTitle))
                            {
                                <div class="cell-subtitle">@cell.SubTitle</div>
                            }
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(cell.ImageUrl))
                            {
                                <img src="@cell.ImageUrl" alt="@cell.Title" style="max-width:100%;max-height:80%;" />
                            }
                            else
                            {
                                <span class="poke-icon">👆</span>
                            }
                        }
                    </div>
                }
            </div>

            <div class="obs-controls">
                @if (template.Mode == PokeMode.Random)
                {
                    <button class="obs-poke-btn" @onclick="@PokeRandom">隨機戳一格</button>
                }
                <button class="obs-record-btn" @onclick="@EndActivityAndRecord" disabled="@(!CanRecordCurrentActivity || isRecording)">
                    @(isRecording ? "記錄中…" : "結束本次活動並記錄")
                </button>
                <button class="obs-reset-btn" @onclick="@ResetTemplate">重設</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <div class="obs-feedback @(statusIsError ? "obs-feedback-error" : "obs-feedback-success")">@statusMessage</div>
            }
        </div>
    </div>
}

<style>
    /* OBS 透明背景 */
    html, body, #app, .obs-layout {
        background: transparent !important;
        margin: 0;
        padding: 0;
    }

    .obs-poke-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 24px;
        gap: 12px;
    }

    .obs-layout-surface {
        --obs-accent-gradient: linear-gradient(135deg, #ffcb47, #ff9f1a);
    }

    .obs-stage {
        width: min(100%, 980px);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        padding: 24px;
        border-radius: 32px;
        background:
            radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.12), transparent 28%),
            var(--obs-accent-gradient),
            linear-gradient(180deg, rgba(12, 18, 34, 0.78), rgba(12, 18, 34, 0.52));
        border: 1px solid rgba(255, 255, 255, 0.14);
        box-shadow: 0 28px 72px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(10px);
    }

    .obs-state {
        min-width: 320px;
        max-width: 520px;
        margin: 24px;
        padding: 20px 24px;
        border-radius: 14px;
        background: var(--el-surface-strong);
        color: var(--el-text);
        text-align: center;
        box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
        border: 1px solid var(--el-border);
    }

    .obs-state-error {
        border: 1px solid rgba(248, 113, 113, 0.4);
    }

    .obs-state-title {
        font-size: 1.2rem;
        font-weight: 700;
    }

    .obs-state-hint {
        margin-top: 8px;
        font-size: 0.92rem;
        line-height: 1.5;
        opacity: 0.82;
    }

    .poke-grid {
        gap: 8px;
        width: 100%;
        max-width: 760px;
    }

    .poke-cell {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        cursor: pointer;
        min-height: 80px;
        font-size: 0.85rem;
        text-align: center;
        padding: 4px;
        transition: transform 0.2s, box-shadow 0.2s;
        background: var(--el-surface-strong);
        color: var(--el-text);
        border: 2px solid var(--el-border-strong);
        user-select: none;
        overflow: hidden;
    }

    .poke-cell:hover:not(.revealed) {
        transform: scale(1.05);
        box-shadow: 0 0 12px var(--el-glow);
    }

    .poke-cell.revealed {
        cursor: default;
    }

    .poke-cell.revealed::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.24), transparent 38%, rgba(255, 255, 255, 0.08));
        pointer-events: none;
        animation: reveal-sheen 1.1s ease-out infinite;
        mix-blend-mode: screen;
    }

    .poke-cell.revealed::after {
        content: "✦";
        position: absolute;
        top: 8px;
        right: 10px;
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.9);
        text-shadow: 0 0 10px var(--el-glow);
        animation: reveal-star 1s ease-in-out infinite;
        pointer-events: none;
    }

    .poke-cell .poke-icon {
        font-size: 1.8rem;
    }

    .poke-cell .cell-title {
        font-weight: bold;
        margin-top: 4px;
    }

    .poke-cell .cell-subtitle {
        font-size: 0.75rem;
        opacity: 0.8;
    }

    /* Animation classes */
    .poke-cell.just-poked.anim-burst {
        animation: burst 0.5s ease-out;
    }

    .poke-cell.just-poked.anim-bounce {
        animation: bounce 0.5s ease-out;
    }

    .poke-cell.just-poked.anim-flash {
        animation: flash 0.5s ease-out;
    }

    .poke-cell.just-poked.anim-smoke {
        animation: smoke 0.6s ease-out;
    }

    .poke-cell.just-poked.anim-flip {
        animation: flip 0.5s ease-out;
    }

    .poke-cell.revealed {
        box-shadow:
            0 0 0 2px rgba(255, 255, 255, 0.08) inset,
            0 12px 26px rgba(0, 0, 0, 0.18);
        animation: reveal-glow 0.7s ease-out;
    }

    @@keyframes burst {
        0% { transform: scale(1); }
        30% { transform: scale(1.4); }
        60% { transform: scale(0.9); }
        100% { transform: scale(1); }
    }

    @@keyframes bounce {
        0%, 100% { transform: translateY(0); }
        30% { transform: translateY(-16px); }
        60% { transform: translateY(-8px); }
    }

    @@keyframes flash {
        0%, 100% { opacity: 1; box-shadow: none; }
        50% { opacity: 0.5; box-shadow: 0 0 24px 8px var(--el-glow); }
    }

    @@keyframes smoke {
        0% { opacity: 1; filter: blur(0); }
        50% { opacity: 0.4; filter: blur(4px); }
        100% { opacity: 1; filter: blur(0); }
    }

    @@keyframes flip {
        0% { transform: rotateY(0); }
        50% { transform: rotateY(90deg); }
        100% { transform: rotateY(0); }
    }

    .obs-controls {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        padding: 14px 16px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.14);
    }

    .obs-poke-btn {
        background: linear-gradient(135deg, #ffcb47, #ff9f1a);
        color: #18121a;
        border: none;
        border-radius: 999px;
        padding: 12px 22px;
        font-size: 0.98rem;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    .obs-poke-btn:hover {
        filter: brightness(0.92);
    }

    .obs-reset-btn {
        background: linear-gradient(135deg, #ef6b6b, #c53e3e);
        color: white;
        border: none;
        border-radius: 999px;
        padding: 12px 22px;
        font-size: 0.98rem;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    .obs-reset-btn:hover {
        filter: brightness(0.92);
    }

    .obs-record-btn {
        background: linear-gradient(135deg, #41c97d, #20935d);
        color: white;
        border: none;
        border-radius: 999px;
        padding: 12px 22px;
        font-size: 0.98rem;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }

    .obs-record-btn:hover:not(:disabled) {
        filter: brightness(0.92);
    }

    .obs-poke-btn:disabled,
    .obs-record-btn:disabled,
    .obs-reset-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .obs-feedback {
        margin-top: 10px;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--el-text);
        background: rgba(15, 23, 42, 0.72);
    }

    .obs-feedback-success {
        border: 1px solid rgba(74, 222, 128, 0.5);
    }

    .obs-feedback-error {
        border: 1px solid rgba(248, 113, 113, 0.5);
    }

    @@keyframes reveal-glow {
        0% { transform: scale(0.96); filter: brightness(0.9); }
        50% { transform: scale(1.02); filter: brightness(1.18); }
        100% { transform: scale(1); filter: brightness(1); }
    }

    @@keyframes reveal-sheen {
        0% { opacity: 0.1; transform: translateX(-6px); }
        50% { opacity: 0.8; transform: translateX(6px); }
        100% { opacity: 0.12; transform: translateX(-6px); }
    }

    @@keyframes reveal-star {
        0%, 100% { transform: scale(0.85) rotate(0deg); opacity: 0.5; }
        50% { transform: scale(1.15) rotate(12deg); opacity: 1; }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private PokeTemplate? template;
    private int? lastPokedIndex;
    private bool isLoading = true;
    private LiveDrawPhase flowPhase = LiveDrawPhase.Ready;
    private int? countdownRemaining;
    private bool isRecording;
    private string? lastRecordedSignature;
    private string? statusMessage;
    private bool statusIsError;

    private const int AnimationDurationMs = 650;
    private const int RevealCountdownSeconds = 2;
    private const int RevealHoldMs = 450;

    private int RevealedCount => template?.Cells.Count(c => c.IsRevealed) ?? 0;
    private bool CanRecordCurrentActivity => template != null && RevealedCount > 0 && BuildRecordSignature() != lastRecordedSignature;
    private bool IsBusy => countdownRemaining.HasValue || flowPhase == LiveDrawPhase.CountingDown || flowPhase == LiveDrawPhase.Spinning;

    private string FlowDetailText => flowPhase switch
    {
        LiveDrawPhase.Ready => "選好格子後，畫面會依序進入倒數、揭露與結果階段。",
        LiveDrawPhase.CountingDown => "準備揭露，請留意接下來的動畫節奏。",
        LiveDrawPhase.Spinning => "戳戳樂正在揭露中。",
        LiveDrawPhase.ShowingResult when RevealedCount >= (template?.Cells.Count ?? 0) => "本次戳戳樂已全部揭露完成。",
        LiveDrawPhase.ShowingResult => "結果已顯示，還可以繼續揭露下一格。",
        _ => "戳戳樂流程已就緒。"
    };

    private string WrapperStyle =>
        string.IsNullOrEmpty(template?.BackgroundImageUrl)
            ? ""
            : $"background:url('{template.BackgroundImageUrl}') center/cover;";

    private string GridStyle =>
        $"display:grid;grid-template-columns:repeat({template?.GridColumns ?? 3},1fr);gap:8px;";

    private string AnimationClass => template?.Animation switch
    {
        PokeAnimation.Burst => "anim-burst",
        PokeAnimation.Bounce => "anim-bounce",
        PokeAnimation.Flash => "anim-flash",
        PokeAnimation.Smoke => "anim-smoke",
        PokeAnimation.Flip => "anim-flip",
        _ => "anim-burst"
    };

    private string CellStyle(PokeCell cell)
    {
        if (cell.IsRevealed)
        {
            var bg = string.IsNullOrEmpty(cell.RevealedColor) ? "#cccccc" : cell.RevealedColor;
            return $"background:{bg};color:var(--el-accent-contrast);border-color:{bg};";
        }
        return "";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplate();
    }

    private async Task LoadTemplate()
    {
        template = await PokeService.LoadTemplateAsync(Id);
        if (template == null)
        {
            await PokeService.SeedDefaultTemplatesAsync();
            template = await PokeService.LoadTemplateAsync(Id);
        }

        isLoading = false;
    }

    private async Task OnCellClick(PokeCell cell)
    {
        if (template == null) return;
        if (template.Mode != PokeMode.Manual) return;
        if (cell.IsRevealed && !template.AllowRePoking) return;

        await RunRevealSequenceAsync(() => PokeService.PokeCellByIndexAsync(template.Id, cell.Index), poked =>
        {
            cell.IsRevealed = true;
            cell.RevealedAt = poked.RevealedAt;
            lastPokedIndex = cell.Index;
        });
    }

    private async Task PokeRandom()
    {
        if (template == null) return;

        await RunRevealSequenceAsync(() => PokeService.PokeRandomCellAsync(template.Id), poked =>
        {
            var cell = template.Cells.FirstOrDefault(c => c.Index == poked.Index);
            if (cell != null)
            {
                cell.IsRevealed = true;
                cell.RevealedAt = poked.RevealedAt;
                lastPokedIndex = cell.Index;
            }
        });
    }

    private async Task ResetTemplate()
    {
        if (template == null) return;
        await PokeService.ResetTemplateAsync(template.Id);
        lastPokedIndex = null;
        lastRecordedSignature = null;
        ClearStatus();
        await LoadTemplate();
    }

    private async Task EndActivityAndRecord()
    {
        if (template == null || !CanRecordCurrentActivity || isRecording || IsBusy) return;

        isRecording = true;
        try
        {
            var record = await ActivityResultService.RecordPokeActivityAsync(template.Id);
            lastRecordedSignature = BuildRecordSignature();
            await ResultNotificationService.NotifyActivityResultAsync(record);
            SetStatus($"已記錄活動「{record.ActivityName}」結果。", false);
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to record poke activity result in OBS view.");
            SetStatus(ex.Message, true);
        }
        finally
        {
            isRecording = false;
        }
    }

    private async Task ClearAnimationAfterDelay()
    {
        await Task.Delay(AnimationDurationMs);
        lastPokedIndex = null;
        StateHasChanged();
    }

    private async Task RunRevealSequenceAsync(Func<Task<PokeCell?>> revealAsync, Action<PokeCell> applyReveal)
    {
        if (template == null || IsBusy)
        {
            return;
        }

        flowPhase = LiveDrawPhase.CountingDown;
        countdownRemaining = RevealCountdownSeconds;
        SetStatus("倒數開始，準備揭露戳戳樂。", false);
        await SoundCueService.PlayCueAsync(SoundCueService.GetPreset(await SoundCueService.GetActivePresetKeyAsync()).CountdownCue);
        StateHasChanged();

        while (countdownRemaining > 0)
        {
            await Task.Delay(1000);
            countdownRemaining--;
            StateHasChanged();
        }

        flowPhase = LiveDrawPhase.Spinning;
        countdownRemaining = null;
        await SoundCueService.PlayCueAsync(SoundCueService.GetPreset(await SoundCueService.GetActivePresetKeyAsync()).PokeCue);
        StateHasChanged();

        await Task.Delay(220);
        var poked = await revealAsync();
        if (poked == null)
        {
            flowPhase = LiveDrawPhase.Ready;
            ClearStatus();
            StateHasChanged();
            return;
        }

        applyReveal(poked);
        flowPhase = LiveDrawPhase.ShowingResult;
        await SoundCueService.PlayCueAsync(SoundCueService.GetPreset(await SoundCueService.GetActivePresetKeyAsync()).RevealCue);
        SetStatus($"已揭露第 {poked.Index + 1} 格。", false);
        StateHasChanged();

        await Task.Delay(RevealHoldMs);
        await ClearAnimationAfterDelay();
        flowPhase = LiveDrawPhase.Ready;
        StateHasChanged();
    }

    private string BuildRecordSignature()
    {
        if (template == null)
        {
            return "";
        }

        return string.Join(
            '|',
            template.Cells
                .Where(cell => cell.IsRevealed)
                .OrderBy(cell => cell.Index)
                .Select(cell => $"{cell.Id}:{cell.RevealedAt?.Ticks ?? 0}"));
    }

    private void SetStatus(string message, bool isError)
    {
        statusMessage = message;
        statusIsError = isError;
    }

    private void ClearStatus()
    {
        statusMessage = null;
        statusIsError = false;
    }
}
