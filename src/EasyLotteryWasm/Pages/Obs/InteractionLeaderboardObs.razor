@page "/obs/interaction-leaderboard/{RoundId:guid}"
@layout ObsLayout
@implements IAsyncDisposable
@inject InteractionRealtimeClient Realtime
<div class="interaction-obs" aria-live="polite">@if (snapshot is not null) { <h1>@snapshot.Name</h1><ol>@foreach (var entry in snapshot.Leaderboard) { <li>@entry.DisplayName — @entry.Points</li> }</ol> }</div>
@code { [Parameter] public Guid RoundId { get; set; } private InteractionRoundSnapshot? snapshot; protected override async Task OnInitializedAsync(){ Realtime.StateChanged+=OnStateChanged; await Realtime.StartAsync(RoundId); } private Task OnStateChanged(InteractionRoundSnapshot? value){snapshot=value;return InvokeAsync(StateHasChanged);} public async ValueTask DisposeAsync(){Realtime.StateChanged-=OnStateChanged;await Realtime.DisposeAsync();} }
<style>html,body,#app,.obs-layout{background:transparent!important}.interaction-obs{min-height:100vh;color:white;text-shadow:0 2px 4px #000;padding:2rem}</style>
