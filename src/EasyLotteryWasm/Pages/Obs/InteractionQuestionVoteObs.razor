@page "/obs/interaction-vote/{RoundId:guid}"
@layout ObsLayout
@implements IAsyncDisposable
@inject InteractionRealtimeClient Realtime
<div class="interaction-obs" aria-live="polite">@if (snapshot is not null) { <h1>@snapshot.Name</h1><div class="vote-options">@foreach (var option in snapshot.VoteOptions) { <span>@option: @snapshot.VoteCounts.GetValueOrDefault(option)</span> }</div> }</div>
@code { [Parameter] public Guid RoundId { get; set; } private InteractionRoundSnapshot? snapshot; protected override async Task OnInitializedAsync() { Realtime.StateChanged += OnStateChanged; await Realtime.StartAsync(RoundId); } private Task OnStateChanged(InteractionRoundSnapshot? value) { snapshot=value; return InvokeAsync(StateHasChanged); } public async ValueTask DisposeAsync(){ Realtime.StateChanged-=OnStateChanged; await Realtime.DisposeAsync(); } }
<style>html,body,#app,.obs-layout{background:transparent!important}.interaction-obs{min-height:100vh;color:white;text-shadow:0 2px 4px #000;padding:2rem}.vote-options{display:flex;gap:1rem}.vote-options span{padding:.5rem 1rem;background:#0008;border-radius:.5rem}</style>
