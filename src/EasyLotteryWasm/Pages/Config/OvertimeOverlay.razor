@page "/activity/overtime"
@using System.Globalization
@using EasyLotteryDomain.Models.Config
@using EasyLotteryDomain.Models.Overtime
@using EasyLotteryDomain.Services
@using EasyLotteryWasm.Models
@inject IEasyLotteryConfigStore ConfigStore
@inject IMessageService MessageService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject OvertimeFeedClient OvertimeFeedClient

<PageTitle>加班台</PageTitle>

@if (isLoading)
{
    <Card>
        <CardBody>
            <div class="text-muted">加班台設定載入中…</div>
        </CardBody>
    </Card>
}
else
{
    <Card class="overtime-settings-shell">
        <CardBody>
            <div class="overtime-page-header">
                <div>
                    <div class="overtime-eyebrow">LIVE SUPPORT OVERLAY</div>
                    <h2 class="overtime-title">加班台設定</h2>
                    <div class="overtime-subtitle">設定直播加班台的事件來源與畫面樣式。</div>
                </div>
            </div>

            <Row>
                <Column ColumnSize="ColumnSize.Is12">
                    <Card class="overtime-config-card">
                        <CardBody>
                            <Row>
                                <Column ColumnSize="ColumnSize.Is6">
                                    <Field>
                                        <FieldLabel>OBS 開始控制</FieldLabel>
                                        <div class="text-muted">開始按鈕已移到 OBS 頁，這裡只保留設定與預覽。</div>
                                    </Field>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is6">
                                    <Field>
                                        <FieldLabel>最大顯示筆數</FieldLabel>
                                        <NumericInput TValue="int" @bind-Value="@settings.MaxVisibleItems" Min="1" Max="30" />
                                    </Field>
                                </Column>
                            </Row>

                            <Field>
                                <FieldLabel>標題</FieldLabel>
                                <TextInput @bind-Value="@settings.Title" Placeholder="例如：加班台" />
                            </Field>

                            <Field>
                                <FieldLabel>副標題</FieldLabel>
                                <TextInput @bind-Value="@settings.Subtitle" Placeholder="例如：SuperChat / 綠界贊助" />
                            </Field>

                            <Row>
                                <Column ColumnSize="ColumnSize.Is6">
                                    <Field>
                                        <FieldLabel>顯示金額</FieldLabel>
                                        <Switch TValue="bool" @bind-Value="@settings.ShowAmounts">
                                            @(settings.ShowAmounts ? "顯示" : "隱藏")
                                        </Switch>
                                    </Field>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is6">
                                    <Field>
                                        <FieldLabel>顯示頭像</FieldLabel>
                                        <Switch TValue="bool" @bind-Value="@settings.ShowAvatars">
                                            @(settings.ShowAvatars ? "顯示" : "隱藏")
                                        </Switch>
                                    </Field>
                                </Column>
                            </Row>

                            <div class="overtime-time-card">
                                <div class="overtime-time-title">預計結束時間</div>
                                <div class="overtime-time-hint">先設定預計關台時間。OBS 按下開始後，donate 才會在這個時間基準上往後延長。</div>
                                <Row>
                                    <Column ColumnSize="ColumnSize.Is12">
                                        <Field>
                                            <FieldLabel>預計結束時間</FieldLabel>
                                              <input class="overtime-datetime-input"
                                                  type="datetime-local"
                                                  value="@PlannedEndAtInput"
                                                  @oninput="OnPlannedEndAtInputChanged" />
                                        </Field>
                                    </Column>
                                </Row>
                                <Row>
                                    <Column ColumnSize="ColumnSize.Is6">
                                        <Field>
                                            <FieldLabel>單行訊息顯示秒數</FieldLabel>
                                            <NumericInput TValue="int" @bind-Value="@settings.SupportMessageVisibleSeconds" Min="1" Max="60" />
                                        </Field>
                                    </Column>
                                </Row>
                                <Row Margin="Margin.Is2.FromTop">
                                    <Column ColumnSize="ColumnSize.Is4">
                                        <Field>
                                            <FieldLabel>達標煙火</FieldLabel>
                                            <Switch TValue="bool" @bind-Value="settings.EnableCompletionFireworks">
                                                @(settings.EnableCompletionFireworks ? "啟用" : "停用")
                                            </Switch>
                                        </Field>
                                    </Column>
                                    <Column ColumnSize="ColumnSize.Is4">
                                        <Field>
                                            <FieldLabel>煙火風格</FieldLabel>
                                            <select class="form-select" @bind="settings.CompletionFireworksStyle" disabled="@(!settings.EnableCompletionFireworks)">
                                                <option value="classic">經典煙火</option>
                                                <option value="pixel">像素煙火</option>
                                            </select>
                                        </Field>
                                    </Column>
                                    <Column ColumnSize="ColumnSize.Is4">
                                        <Field>
                                            <FieldLabel>播放秒數</FieldLabel>
                                            <NumericInput TValue="int" @bind-Value="settings.CompletionFireworksDurationSeconds" Min="2" Max="15" Disabled="@(!settings.EnableCompletionFireworks)" />
                                        </Field>
                                    </Column>
                                </Row>
                                <Field>
                                    <FieldLabel>自訂煙火 GIF 網址</FieldLabel>
                                    <TextInput @bind-Value="settings.CompletionFireworksGifUrl" Placeholder="https://example.com/fireworks.gif" Disabled="@(!settings.EnableCompletionFireworks)" />
                                    <div class="text-muted mt-1">選填。設定後會優先顯示 GIF，並在播放秒數內循環重新播放。</div>
                                </Field>
                            </div>

                            <div class="overtime-rules-card">
                                <div class="overtime-rules-header">
                                    <div>
                                        <div class="overtime-rules-title">金額換算加班時間</div>
                                        <div class="overtime-rules-hint">設定每筆贊助滿多少錢，就要加幾小時或幾分鐘。</div>
                                    </div>
                                    <div class="overtime-rules-actions">
                                        <Button Size="Size.Small" Color="Color.Secondary" Clicked="@ResetRewardRules">重設預設</Button>
                                        <Button Size="Size.Small" Color="Color.Primary" Clicked="@AddRewardRule">新增規則</Button>
                                    </div>
                                </div>

                                @if (settings.RewardRules.Count == 0)
                                {
                                    <div class="overtime-rules-empty">目前還沒有規則，先按「新增規則」建立一筆。</div>
                                }
                                else
                                {
                                    <div class="overtime-rules-list">
                                        @for (var index = 0; index < settings.RewardRules.Count; index++)
                                        {
                                            var rule = settings.RewardRules[index];
                                            <div class="overtime-rule-row">
                                                <div class="overtime-rule-main">
                                                    <Field>
                                                        <FieldLabel>規則名稱</FieldLabel>
                                                        <TextInput @bind-Value="@rule.Label" Placeholder="例如：滿 300 元加 30 分" />
                                                    </Field>
                                                    <Row>
                                                        <Column ColumnSize="ColumnSize.Is4">
                                                            <Field>
                                                                <FieldLabel>門檻金額</FieldLabel>
                                                                <NumericInput TValue="decimal" @bind-Value="@rule.AmountThreshold" Min="0" />
                                                            </Field>
                                                        </Column>
                                                        <Column ColumnSize="ColumnSize.Is4">
                                                            <Field>
                                                                <FieldLabel>加幾小時</FieldLabel>
                                                                <NumericInput TValue="int" @bind-Value="@rule.AddHours" Min="0" />
                                                            </Field>
                                                        </Column>
                                                        <Column ColumnSize="ColumnSize.Is4">
                                                            <Field>
                                                                <FieldLabel>加幾分鐘</FieldLabel>
                                                                <NumericInput TValue="int" @bind-Value="@rule.AddMinutes" Min="0" />
                                                            </Field>
                                                        </Column>
                                                    </Row>
                                                </div>
                                                <div class="overtime-rule-side">
                                                    <Field>
                                                        <FieldLabel>啟用</FieldLabel>
                                                        <Switch TValue="bool" @bind-Value="@rule.IsEnabled">
                                                            @(rule.IsEnabled ? "啟用" : "停用")
                                                        </Switch>
                                                    </Field>
                                                    <Button Size="Size.Small" Color="Color.Danger" Clicked="@(() => RemoveRewardRule(index))">刪除</Button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <Field>
                                <FieldLabel>單行文字動畫</FieldLabel>
                                <select class="overtime-animation-select" value="@selectedTextAnimationKey" @onchange="OnTextAnimationChanged">
                                    @foreach (var preset in textAnimationPresets)
                                    {
                                        <option value="@preset.Key">@preset.Name</option>
                                    }
                                </select>
                                <div class="text-muted mt-1">@SelectedTextAnimation.Description</div>
                            </Field>

                            <Row>
                                <Column ColumnSize="ColumnSize.Is6">
                                    <Field>
                                        <FieldLabel>示範 SuperChat 金額</FieldLabel>
                                        <NumericInput TValue="decimal" @bind-Value="@settings.DemoSuperChatAmount" Min="0" />
                                    </Field>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is6">
                                    <Field>
                                        <FieldLabel>示範綠界金額</FieldLabel>
                                        <NumericInput TValue="decimal" @bind-Value="@settings.DemoEcpayAmount" Min="0" />
                                    </Field>
                                </Column>
                            </Row>

                            <div class="d-flex gap-2 flex-wrap mt-4">
                                <Button Color="Color.Primary" Clicked="@SaveAsync">儲存設定</Button>
                                <Button Color="Color.Success" Clicked="@SendDemoSuperChatAsync">送出示範 SuperChat (@FormatAmountDisplay(settings.DemoSuperChatAmount))</Button>
                                <Button Color="Color.Warning" Clicked="@SendDemoEcpayAsync">送出示範綠界 Donate (@FormatAmountDisplay(settings.DemoEcpayAmount))</Button>
                                <Button Color="Color.Danger" Clicked="@ClearFeedAsync">清除加班台訊息</Button>
                            </div>
                        </CardBody>
                    </Card>
                </Column>

            </Row>

            <div class="overtime-links-panel mt-4">
                <div class="overtime-links-header">
                    <h5 class="overtime-links-title">OBS 連結</h5>
                    <div class="overtime-links-hint">把這個網址貼到 OBS 的瀏覽器來源即可。</div>
                </div>
                <div class="overtime-links-list">
                    <div class="overtime-link-row">
                        <div class="overtime-link-label">OBS 來源網址</div>
                        <input class="overtime-link-value" value="@OverlayUrl" readonly />
                        <Button Size="Size.Small" Color="Color.Primary" Clicked="@CopyOverlayUrlAsync">複製</Button>
                    </div>
                </div>
            </div>
        </CardBody>
    </Card>
}

