    private DateTimeOffset? CalculateRewardExtension(decimal? amount, DateTimeOffset? currentSessionEndAtUtc, DateTimeOffset nowUtc)
    {
        var matchedRule = OvertimeRewardRuleCalculator.FindMatchedRule(settings.RewardRules, amount);
        if (matchedRule == null)
        {
            return currentSessionEndAtUtc;
        }

        return OvertimeSessionTimeCalculator.ExtendPlannedEnd(
            currentSessionEndAtUtc,
            matchedRule,
            nowUtc);
    }

    private async Task<bool> IsSessionStartedAsync()
    {
        var latestDocument = await ConfigStore.LoadAsync();
        return latestDocument.OvertimeOverlay?.SessionState == OvertimeSessionStates.Running;
    }

    private async Task<DateTimeOffset?> GetCurrentSessionEndAtAsync()
    {
        var latestDocument = await ConfigStore.LoadAsync();
        return latestDocument.OvertimeOverlay?.PlannedEndAtUtc ?? settings.PlannedEndAtUtc;
    }

