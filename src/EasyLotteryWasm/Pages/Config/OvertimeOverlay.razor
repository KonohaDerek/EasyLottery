    }

    .overtime-datetime-input:focus {
        outline: 3px solid rgba(37, 99, 235, 0.18);
        border-color: rgba(37, 99, 235, 0.55);
    }

    .theme-card-ribbon {
        height: 12px;
        border-radius: 999px;
        margin: 12px 0 12px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.18);
    }

    .theme-card-swatches {
        display: flex;
        gap: 8px;
        margin-top: 14px;
    }

    .theme-card-swatch {
        width: 42px;
        height: 12px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.18);
    }

    .theme-card-key {
        margin-top: 12px;
        font-size: 0.82rem;
        opacity: 0.74;
        word-break: break-all;
    }

    .overtime-rules-card {
        margin-top: 16px;
        padding: 18px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.96);
        color: #0f172a;
        border: 1px solid rgba(148, 163, 184, 0.2);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75);
