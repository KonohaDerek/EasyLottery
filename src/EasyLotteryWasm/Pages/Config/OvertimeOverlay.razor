            Currency = "TWD",
            AvatarUrl = "",
            Color = "#8bd3ff",
            ExternalId = Guid.NewGuid().ToString("N"),
            OccurredAtUtc = DateTimeOffset.UtcNow,
            SessionEndAtUtc = plannedEndAtUtc
        });
    }

