    }

    .overtime-rules-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .overtime-rule-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 170px;
        gap: 14px;
        padding: 14px;
        border-radius: 16px;
        background: rgba(248, 250, 252, 0.95);
        border: 1px solid rgba(148, 163, 184, 0.18);
    }

    .overtime-rule-main {
        min-width: 0;
    }

    .overtime-rule-side {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 10px;
        align-items: flex-start;
    }

    @@media (max-width: 767.98px) {
        .overtime-rule-row {
            grid-template-columns: 1fr;
        }

        .overtime-rule-side {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }
    }

    .overtime-links-panel {
        padding: 22px 24px;
        border-radius: 20px;
        background: linear-gradient(180deg, rgba(10, 16, 36, 0.98), rgba(18, 24, 50, 0.96));
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.22);
    }

    .overtime-links-header {
        margin-bottom: 14px;
    }

    .overtime-links-title {
        margin: 0;
        color: #f8fbff;
        font-weight: 900;
        font-size: 1.15rem;
    }

    .overtime-links-hint {
        margin-top: 4px;
        color: rgba(236, 242, 255, 0.76);
        font-size: 0.92rem;
    }

    .overtime-links-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .overtime-link-row {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr) auto;
        gap: 12px;
        align-items: center;
        padding: 14px 16px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(148, 163, 184, 0.18);
    }

    .overtime-link-label {
        color: #0f172a;
        font-weight: 800;
    }

    .overtime-link-value {
        width: 100%;
        min-width: 0;
        border: 1px solid rgba(148, 163, 184, 0.35);
        border-radius: 12px;
        padding: 10px 12px;
        background: #fff;
        color: #0f172a;
        font-size: 0.95rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    }

    .overtime-link-value:focus {
        outline: 3px solid rgba(37, 99, 235, 0.18);
        border-color: rgba(37, 99, 235, 0.55);
    }

    @@media (max-width: 767.98px) {
        .overtime-link-row {
            grid-template-columns: 1fr;
        }

        .overtime-link-value {
            order: 2;
        }

        .overtime-link-row .btn {
            width: 100%;
            order: 3;
        }
    }
</style>

@code {
    private const string PlannedEndMarkerLabel = "預計關台時間";
    private const string SessionStartMarkerLabel = "加班開始";
    private const string SessionStopMarkerLabel = "加班停止";

    private bool isLoading = true;
    private EasyLotteryConfigDocument document = new();
    private OvertimeOverlaySettings settings = new();
    private IReadOnlyList<OvertimeThemePreset> presets = OvertimeThemePreset.Catalog;
    private string selectedThemeKey = OvertimeThemePreset.Catalog[0].Key;
    private string OverlayUrl => NavigationManager.ToAbsoluteUri("/obs/overtime").ToString();
    private string PlannedEndAtInput { get; set; } = "";

    private OvertimeThemePreset CurrentTheme => OvertimeThemePreset.GetByKey(selectedThemeKey);

    protected override async Task OnInitializedAsync()
    {
        document = await ConfigStore.LoadAsync();
        settings = document.OvertimeOverlay ?? new OvertimeOverlaySettings();
        settings.RewardRules ??= new List<OvertimeRewardRule>();
        settings.DemoSuperChatAmount = Math.Max(0, settings.DemoSuperChatAmount);
        settings.DemoEcpayAmount = Math.Max(0, settings.DemoEcpayAmount);
        selectedThemeKey = string.IsNullOrWhiteSpace(settings.ThemeKey) ? OvertimeThemePreset.Catalog[0].Key : settings.ThemeKey;
        PlannedEndAtInput = FormatDateTimeLocal(settings.PlannedEndAtUtc);
        isLoading = false;
    }

    private void OnPlannedEndAtInputChanged(ChangeEventArgs args)
    {
        PlannedEndAtInput = args.Value?.ToString() ?? "";
        settings.PlannedEndAtUtc = ParseDateTimeLocal(PlannedEndAtInput);
    }

    private void SelectTheme(string key)
    {
        selectedThemeKey = key;
        settings.ThemeKey = key;
    }

    private void AddRewardRule()
    {
        settings.RewardRules.Add(new OvertimeRewardRule
        {
            Label = "新規規則",
            AmountThreshold = 100,
            AddMinutes = 30,
            IsEnabled = true
        });
    }

    private void ResetRewardRules()
    {
        settings.RewardRules = new OvertimeOverlaySettings().RewardRules
            .Select(rule => new OvertimeRewardRule
            {
                Label = rule.Label,
                AmountThreshold = rule.AmountThreshold,
                AddHours = rule.AddHours,
                AddMinutes = rule.AddMinutes,
                IsEnabled = rule.IsEnabled
            })
            .ToList();
    }

    private void RemoveRewardRule(int index)
    {
        if (index >= 0 && index < settings.RewardRules.Count)
        {
            settings.RewardRules.RemoveAt(index);
        }
    }

    private async Task SaveAsync()
    {
        settings.PlannedEndAtUtc = ParseDateTimeLocal(PlannedEndAtInput);
        document.OvertimeOverlay = settings;
        document.OvertimeOverlay.ThemeKey = selectedThemeKey;
        await ConfigStore.SaveAsync(document);

        if (!await IsSessionStartedAsync())
        {
            await PublishPlannedEndMarkerAsync(settings.PlannedEndAtUtc);
        }

        await MessageService.Success("已儲存加班台設定。");
    }

    private async Task CopyOverlayUrlAsync()
    {
        await JSRuntime.InvokeVoidAsync("easyLotteryClipboard.copyText", OverlayUrl);
        await MessageService.Success("已複製 OBS 網址。");
    }

    private async Task SendDemoSuperChatAsync()
    {
        var nowUtc = DateTimeOffset.UtcNow;
        var isStarted = await IsSessionStartedAsync();
        var currentSessionEndAtUtc = await GetCurrentSessionEndAtAsync();
        var sessionEndAtUtc = isStarted
            ? CalculateRewardExtension(settings.DemoSuperChatAmount, currentSessionEndAtUtc, nowUtc)
            : currentSessionEndAtUtc;

        var entry = await OvertimeFeedClient.PostSuperChatAsync(new OvertimeSupportEvent
        {
            Source = OvertimeSupportSource.SuperChat,
            SourceLabel = "YouTube SuperChat",
            DisplayName = "示範觀眾",
            Message = "祝直播順利，這是示範 SuperChat。",
            Amount = settings.DemoSuperChatAmount,
            AmountDisplay = FormatAmountDisplay(settings.DemoSuperChatAmount),
            Currency = "TWD",
            AvatarUrl = "https://placehold.co/96x96/png",
            Color = "#ff7ab6",
            ExternalId = Guid.NewGuid().ToString("N"),
            OccurredAtUtc = nowUtc,
            SessionEndAtUtc = sessionEndAtUtc
        });

        if (entry != null && isStarted)
        {
            settings.PlannedEndAtUtc = entry.SessionEndAtUtc;
            document.OvertimeOverlay = settings;
            await ConfigStore.SaveAsync(document);
            await PublishPlannedEndMarkerAsync(settings.PlannedEndAtUtc);
            await MessageService.Success("已送出示範 SuperChat。");
        }
    }

