@page "/roulette"
@using EasyLotteryDomain.Models.Entities
@using EasyLotteryDomain.Services

@inject RouletteService RouletteService
@inject NavigationManager NavigationManager
@inject IMessageService MessageService

<PageTitle>轉盤 - 模板列表</PageTitle>

<div class="roulette-page">
    <section class="roulette-hero">
        <div class="roulette-hero-copy">
            <div class="roulette-eyebrow">ROULETTE CONTROL CENTER</div>
            <h3 class="roulette-title">轉盤模板管理</h3>
            <p class="roulette-subtitle">集中管理轉盤模板、預覽結果與匯入匯出內容，讓抽獎流程更像一個乾淨的後台作業台。</p>
        </div>

        <div class="roulette-hero-actions">
            <Button Color="Color.Primary" Clicked="@NavigateToCreate">新增模板</Button>
            <Button Color="Color.Secondary" Clicked="@SeedDefaults">載入預設模板</Button>
        </div>
    </section>

    @if (templates == null)
    {
        <div class="roulette-state-panel">載入中…</div>
    }
    else
    {
        <section class="roulette-metric-grid">
            <div class="roulette-metric-card">
                <div class="roulette-metric-label">模板總數</div>
                <div class="roulette-metric-value">@templates.Count</div>
            </div>
            <div class="roulette-metric-card">
                <div class="roulette-metric-label">草稿</div>
                <div class="roulette-metric-value">@templates.Count(t => t.PublicationStatus == TemplatePublicationStatus.Draft)</div>
            </div>
            <div class="roulette-metric-card">
                <div class="roulette-metric-label">已發布</div>
                <div class="roulette-metric-value">@templates.Count(t => t.PublicationStatus == TemplatePublicationStatus.Published)</div>
            </div>
            <div class="roulette-metric-card">
                <div class="roulette-metric-label">內建模板</div>
                <div class="roulette-metric-value">@templates.Count(t => t.IsBuiltIn)</div>
            </div>
        </section>

        @if (!templates.Any())
        {
            <div class="roulette-empty-state">
                <div class="roulette-empty-title">尚無模板</div>
                <div class="roulette-empty-description">可以先載入預設模板，或直接建立第一個轉盤模板。</div>
            </div>
        }
        else
        {
            <section class="roulette-table-shell">
                <Table FullWidth Striped Hoverable Bordered Responsive class="roulette-table">
                    <TableHeader>
                        <TableRow>
                            <TableHeaderCell>名稱</TableHeaderCell>
                            <TableHeaderCell>說明</TableHeaderCell>
                            <TableHeaderCell>狀態</TableHeaderCell>
                            <TableHeaderCell>格數</TableHeaderCell>
                            <TableHeaderCell>旋轉時間</TableHeaderCell>
                            <TableHeaderCell>Easing</TableHeaderCell>
                            <TableHeaderCell>操作</TableHeaderCell>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var t in templates)
                        {
                            <TableRow>
                                <TableRowCell>
                                    <div class="roulette-template-name">
                                        <span>@t.Name</span>
                                        @if (t.IsBuiltIn)
                                        {
                                            <Badge Color="Color.Light">內建</Badge>
                                        }
                                    </div>
                                </TableRowCell>
                                <TableRowCell>@t.Description</TableRowCell>
                                <TableRowCell>
                                    <Badge Color="@(t.PublicationStatus == TemplatePublicationStatus.Draft ? Color.Warning : Color.Success)">
                                        @(t.PublicationStatus == TemplatePublicationStatus.Draft ? "草稿" : "已發布")
                                    </Badge>
                                </TableRowCell>
                                <TableRowCell>@t.SegmentCount</TableRowCell>
                                <TableRowCell>@t.SpinDurationSec 秒</TableRowCell>
                                <TableRowCell>@t.EasingFunction</TableRowCell>
                                <TableRowCell>
                                    <div class="roulette-action-row">
                                        <Button Size="Size.Small" Color="Color.Success" Clicked="@(() => NavigateToPreview(t.Id))">預覽</Button>
                                        <Button Size="Size.Small" Color="Color.Warning" Clicked="@(() => NavigateToEditor(t.Id))">編輯</Button>
                                        <Button Size="Size.Small" Color="@(t.PublicationStatus == TemplatePublicationStatus.Draft ? Color.Success : Color.Secondary)" Clicked="@(() => TogglePublicationStatus(t))">
                                            @(t.PublicationStatus == TemplatePublicationStatus.Draft ? "發布" : "轉草稿")
                                        </Button>
                                        <Button Size="Size.Small" Color="Color.Primary" Clicked="@(() => DuplicateTemplate(t.Id))">複製</Button>
                                        <Button Size="Size.Small" Color="Color.Info" Clicked="@(() => ExportTemplate(t.Id))">匯出</Button>
                                        @if (!t.IsBuiltIn)
                                        {
                                            <Button Size="Size.Small" Color="Color.Danger" Clicked="@(() => DeleteTemplate(t.Id))">刪除</Button>
                                        }
                                    </div>
                                </TableRowCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            </section>
        }

        <section class="roulette-import-grid">
            <Card class="roulette-import-card">
                <CardHeader>
                    <CardTitle>匯入模板（JSON）</CardTitle>
                </CardHeader>
                <CardBody>
                    <MemoInput @bind-Value="@importJson" Rows="6" Placeholder="貼上 JSON 模板內容…" />
                    <Button Color="Color.Primary" Clicked="@ImportTemplate" class="mt-3">匯入</Button>
                </CardBody>
            </Card>

            <Card class="roulette-import-card">
                <CardHeader>
                    <CardTitle>匯出結果</CardTitle>
                </CardHeader>
                <CardBody>
                    @if (!string.IsNullOrEmpty(exportJson))
                    {
                        <MemoInput @bind-Value="@exportJson" Rows="10" ReadOnly />
                    }
                    else
                    {
                        <div class="roulette-state-panel roulette-state-panel-inline">選擇任一模板的「匯出」後，內容會顯示在這裡。</div>
                    }
                </CardBody>
            </Card>
        </section>
    }
</div>

@code {
    private List<RouletteTemplate>? templates;
    private string importJson = "";
    private string exportJson = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplates();
    }

    private async Task LoadTemplates()
    {
        templates = await RouletteService.ListTemplatesAsync();
    }

    private void NavigateToCreate()
    {
        NavigationManager.NavigateTo("/roulette/editor/0");
    }

    private void NavigateToEditor(int id)
    {
        NavigationManager.NavigateTo($"/roulette/editor/{id}");
    }

    private void NavigateToPreview(int id)
    {
        NavigationManager.NavigateTo($"/roulette/preview/{id}");
    }

    private async Task SeedDefaults()
    {
        await RouletteService.SeedDefaultTemplatesAsync();
        await LoadTemplates();
        await MessageService.Info("已載入 3 組預設模板。");
    }

    private async Task DeleteTemplate(int id)
    {
        await RouletteService.DeleteTemplateAsync(id);
        await LoadTemplates();
    }

    private async Task DuplicateTemplate(int id)
    {
        var duplicate = await RouletteService.DuplicateTemplateAsync(id);
        await LoadTemplates();
        NavigationManager.NavigateTo($"/roulette/editor/{duplicate.Id}");
        await MessageService.Success($"已建立複本「{duplicate.Name}」。");
    }

    private async Task TogglePublicationStatus(RouletteTemplate template)
    {
        var nextStatus = template.PublicationStatus == TemplatePublicationStatus.Draft
            ? TemplatePublicationStatus.Published
            : TemplatePublicationStatus.Draft;

        await RouletteService.SetPublicationStatusAsync(template.Id, nextStatus);
        await LoadTemplates();
        await MessageService.Success(nextStatus == TemplatePublicationStatus.Published ? "已發布模板。" : "已轉為草稿。");
    }

    private async Task ExportTemplate(int id)
    {
        exportJson = await RouletteService.ExportTemplateAsync(id);
    }

    private async Task ImportTemplate()
    {
        if (string.IsNullOrWhiteSpace(importJson))
        {
            await MessageService.Warning("請貼上 JSON 內容。");
            return;
        }
        try
        {
            await RouletteService.ImportTemplateAsync(importJson);
            importJson = "";
            await LoadTemplates();
            await MessageService.Success("匯入成功！");
        }
        catch (Exception ex)
        {
            await MessageService.Error($"匯入失敗：{ex.Message}");
        }
    }
}
