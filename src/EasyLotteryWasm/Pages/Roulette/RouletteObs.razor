@page "/obs/roulette/{Id:int}"
@page "/obs/roulette/{PublicId:guid}"
@layout ObsLayout
@implements IAsyncDisposable
@using EasyLotteryDomain.Models
@using EasyLotteryDomain.Models.Entities
@using EasyLotteryDomain.Services
@using EasyLotteryWasm.Layout
@using Serilog

@inject ActivityResultService ActivityResultService
@inject ResultNotificationService ResultNotificationService
@inject RouletteService RouletteService
@inject EasyLotteryWasm.Services.SoundCueService SoundCueService
@inject EasyLotteryWasm.Services.LiveDrawSessionClient LiveDrawClient

<PageTitle>轉盤 - OBS</PageTitle>

@if (isLoading)
{
}
else if (template == null)
{
}
else
{
    <div class="obs-roulette-wrapper obs-layout-surface" style="@WrapperStyle">
        <div class="obs-stage">
            <div class="roulette-container">
                @if (isSpinning)
                {
                    <div class="roulette-spinning-aura"></div>
                }

                <div class="roulette-pointer">
                    @if (!string.IsNullOrEmpty(template.PointerImageUrl))
                    {
                        <img src="@template.PointerImageUrl" alt="指針" style="width:40px;" />
                    }
                    else
                    {
                        <div class="default-pointer">▼</div>
                    }
                </div>

                <div class="roulette-wheel-wrapper">
                    <svg class="roulette-wheel @(isSpinning ? "spinning" : "")"
                         viewBox="0 0 400 400"
                         style="@WheelStyle">
                        @{
                            var segments = template.Segments.OrderBy(s => s.Index).ToList();
                            int count = segments.Count;
                            double segAngle = 360.0 / count;
                        }
                        @for (int i = 0; i < count; i++)
                        {
                            var seg = segments[i];
                            var startAngle = i * segAngle - 90;
                            var endAngle = startAngle + segAngle;
                            var midAngle = startAngle + segAngle / 2.0;
                            var path = DescribeSector(200, 200, 180, startAngle, endAngle);
                            var textX = 200 + 120 * Math.Cos(midAngle * Math.PI / 180);
                            var textY = 200 + 120 * Math.Sin(midAngle * Math.PI / 180);
                            var isWinner = lastResult != null && lastResult.SegmentIndex == i && !isSpinning;

                            <g>
                                <path d="@path" fill="@seg.Color"
                                      stroke="var(--el-border-strong)" stroke-width="2"
                                      class="@(isWinner ? "winner-segment" : "")" />
                                <text x="@textX.ToString("F1")" y="@textY.ToString("F1")"
                                      text-anchor="middle" dominant-baseline="middle"
                                      font-size="14" fill="var(--el-text)" font-weight="bold"
                                      transform="rotate(@midAngle.ToString("F1"), @textX.ToString("F1"), @textY.ToString("F1"))">
                                    @seg.Title
                                </text>
                            </g>
                        }
                        @if (!string.IsNullOrEmpty(template.CenterImageUrl))
                        {
                            <image href="@template.CenterImageUrl" x="160" y="160" width="80" height="80" />
                        }
                        else
                        {
                            <circle cx="200" cy="200" r="30" fill="var(--el-surface-strong)" />
                        }
                    </svg>
                </div>

                @if (lastResult != null && !IsBusy)
                {
                    <div class="roulette-result-flare"></div>
                    <div class="obs-win-result">
                        <span class="win-label">🎉 中獎：</span>
                        <span class="win-title">@lastResult.SegmentTitle</span>
                    </div>
                }
            </div>

            <div class="obs-controls">
                <button class="obs-spin-btn" @onclick="@SpinWheelWithCountdown" disabled="@IsBusy">
                    @((IsBusy && flowPhase == LiveDrawPhase.CountingDown) ? $"倒數中… {countdownRemaining}" : "⏳ 倒數 3 秒後轉動")
                </button>
                <button class="obs-spin-btn" @onclick="@SpinWheel" disabled="@IsBusy">
                    @(IsBusy && flowPhase == LiveDrawPhase.Spinning ? "轉動中…" : "🎰 立即轉動")
                </button>
                <button class="obs-record-btn" @onclick="@EndActivityAndRecord" disabled="@(!CanRecordCurrentActivity || isRecording)">
                    @(isRecording ? "記錄中…" : "結束本次活動並記錄")
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <div class="obs-feedback @(statusIsError ? "obs-feedback-error" : "obs-feedback-success")">@statusMessage</div>
            }
        </div>
    </div>
}

<style>
    /* OBS 透明背景 */
    html, body, #app, .obs-layout {
        background: transparent !important;
        margin: 0;
        padding: 0;
    }

    .obs-roulette-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 24px;
        gap: 12px;
    }

    .obs-layout-surface {
        --obs-accent-gradient: linear-gradient(135deg, #ffcb47, #ff9f1a);
    }

    .obs-stage {
        width: min(100%, 1040px);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        padding: 24px;
        border-radius: 32px;
        background:
            radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.12), transparent 28%),
            var(--obs-accent-gradient),
            linear-gradient(180deg, rgba(12, 18, 34, 0.78), rgba(12, 18, 34, 0.52));
        border: 1px solid rgba(255, 255, 255, 0.14);
        box-shadow: 0 28px 72px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(10px);
    }

    .obs-state {
        min-width: 320px;
        max-width: 520px;
        margin: 24px;
        padding: 20px 24px;
        border-radius: 14px;
        background: var(--el-surface-strong);
        color: var(--el-text);
        text-align: center;
        box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
        border: 1px solid var(--el-border);
    }

    .obs-state-error {
        border: 1px solid rgba(248, 113, 113, 0.4);
    }

    .obs-state-title {
        font-size: 1.2rem;
        font-weight: 700;
    }

    .obs-state-hint {
        margin-top: 8px;
        font-size: 0.92rem;
        line-height: 1.5;
        opacity: 0.82;
    }

    .roulette-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        gap: 10px;
    }

    .roulette-spinning-aura,
    .roulette-result-flare {
        position: absolute;
        inset: -24px;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
    }

    .roulette-spinning-aura {
        background:
            radial-gradient(circle, rgba(255, 192, 66, 0.24) 0%, rgba(255, 192, 66, 0.06) 34%, transparent 66%);
        animation: spin-aura 1s ease-in-out infinite;
    }

    .roulette-result-flare {
        background:
            radial-gradient(circle, rgba(255, 211, 104, 0.36) 0%, rgba(255, 211, 104, 0.1) 30%, transparent 70%);
        animation: result-flare 1.1s ease-out infinite;
    }

    .roulette-pointer {
        font-size: 2rem;
        color: var(--el-text);
        text-align: center;
        z-index: 10;
        margin-bottom: -10px;
    }

    .default-pointer {
        font-size: 2.5rem;
        color: var(--el-accent);
        text-shadow: 0 0 8px var(--el-glow);
    }

    .roulette-wheel-wrapper {
        width: min(64vw, 520px);
        height: min(64vw, 520px);
        border-radius: 50%;
        box-shadow:
            0 0 0 10px rgba(255, 255, 255, 0.06),
            0 24px 54px rgba(0, 0, 0, 0.36);
        overflow: hidden;
        position: relative;
        z-index: 1;
    }

    .roulette-wheel {
        width: min(64vw, 520px);
        height: min(64vw, 520px);
        transition-property: transform;
        transition-timing-function: cubic-bezier(0.17, 0.67, 0.12, 0.99);
    }

    .winner-segment {
        filter: brightness(1.4);
        stroke: var(--el-accent) !important;
        stroke-width: 4 !important;
        animation: winner-pulse 0.9s ease-in-out infinite;
    }

    .obs-controls {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        padding: 14px 16px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.14);
    }

    .obs-spin-btn {
        background: linear-gradient(135deg, #ffcb47, #ff9f1a);
        color: #18121a;
        border: none;
        border-radius: 999px;
        padding: 14px 26px;
        font-size: 1rem;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        transition: transform 0.18s ease, filter 0.18s ease;
    }

    .obs-spin-btn:hover:not(:disabled) {
        transform: translateY(-1px);
        filter: brightness(1.03);
    }

    .obs-spin-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .obs-record-btn {
        background: linear-gradient(135deg, #41c97d, #20935d);
        color: white;
        border: none;
        border-radius: 999px;
        padding: 14px 26px;
        font-size: 1rem;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        transition: transform 0.18s ease, filter 0.18s ease;
    }

    .obs-record-btn:hover:not(:disabled) {
        transform: translateY(-1px);
        filter: brightness(1.03);
    }

    .obs-record-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .obs-win-result {
        display: inline-flex;
        align-items: baseline;
        gap: 10px;
        padding: 12px 18px;
        border-radius: 999px;
        font-size: 1.2rem;
        color: var(--el-text);
        text-align: center;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.2);
        position: relative;
        z-index: 1;
    }

    .obs-win-result .win-label {
        opacity: 0.8;
    }

    .obs-win-result .win-title {
        font-weight: bold;
        color: var(--el-accent);
        font-size: 1.6rem;
        text-shadow: 0 0 12px var(--el-glow);
        animation: result-pop 0.35s ease-out;
    }

    .obs-feedback {
        margin-top: 10px;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--el-text);
        background: rgba(15, 23, 42, 0.72);
    }

    .obs-feedback-success {
        border: 1px solid rgba(74, 222, 128, 0.5);
    }

    .obs-feedback-error {
        border: 1px solid rgba(248, 113, 113, 0.5);
    }

    @@keyframes winner-pulse {
        0%, 100% { filter: brightness(1.3); }
        50% { filter: brightness(1.7); }
    }

    @@keyframes result-pop {
        0% { transform: scale(0.96); opacity: 0.4; }
        100% { transform: scale(1); opacity: 1; }
    }

    @@keyframes spin-aura {
        0%, 100% { transform: scale(0.98); opacity: 0.7; }
        50% { transform: scale(1.04); opacity: 1; }
    }

    @@keyframes result-flare {
        0% { transform: scale(0.92); opacity: 0.3; }
        40% { transform: scale(1.02); opacity: 0.9; }
        100% { transform: scale(1.08); opacity: 0.0; }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public Guid PublicId { get; set; }
    private Guid ActivePublicId => PublicId != Guid.Empty ? PublicId : template?.PublicId ?? Guid.Empty;

    private RouletteTemplate? template;
    private SpinResult? lastResult;
    private bool isSpinning = false;
    private bool isLoading = true;
    private LiveDrawPhase flowPhase = LiveDrawPhase.Ready;
    private int? countdownRemaining;
    private double currentRotation = 0;
    private bool isRecording;
    private string? lastRecordedSignature;
    private string? statusMessage;
    private bool statusIsError;
    private long appliedRevision;

    private const int PostSpinDelayMs = 300;
    private const int SpinCountdownSeconds = 3;
    private bool IsBusy => isSpinning || countdownRemaining.HasValue;
    private bool CanRecordCurrentActivity => template != null && lastResult != null && !IsBusy && BuildRecordSignature() != lastRecordedSignature;

    private string WrapperStyle =>
        string.IsNullOrEmpty(template?.BackgroundImageUrl)
            ? ""
            : $"background:url('{template.BackgroundImageUrl}') center/cover;";

    private string WheelStyle =>
        $"transform: rotate({currentRotation}deg); " +
        $"transition-duration: {(isSpinning ? template?.SpinDurationSec ?? 5.0 : 0)}s;";

    protected override async Task OnInitializedAsync()
    {
        template = PublicId == Guid.Empty
            ? await RouletteService.LoadTemplateAsync(Id)
            : await RouletteService.LoadTemplateAsync(PublicId);
        if (template == null)
        {
            await RouletteService.SeedDefaultTemplatesAsync();
            template = PublicId == Guid.Empty
                ? await RouletteService.LoadTemplateAsync(Id)
                : await RouletteService.LoadTemplateAsync(PublicId);
        }

        isLoading = false;
        if (ActivePublicId != Guid.Empty && template is not null)
        {
            LiveDrawClient.StateChanged += ApplyLiveStateAsync;
            var state = await LiveDrawClient.StartAsync("roulette", ActivePublicId);
            if (state is not null) await ApplyLiveStateAsync(state);
        }
    }

    private async Task SpinWheel()
    {
        await StartSpinAsync(null, false);
    }

    private async Task SpinWheelWithCountdown()
    {
        await StartSpinAsync(null, true);
    }

    private async Task StartSpinAsync(int? forced, bool useCountdown)
    {
        if (template == null || IsBusy) return;

        if (ActivePublicId != Guid.Empty)
        {
            try
            {
                await LiveDrawClient.SpinAsync(new RouletteLiveDrawCommand(forced, useCountdown ? SpinCountdownSeconds : 0));
            }
            catch (Exception exception)
            {
                Log.Error(exception, "Live roulette command failed.");
                SetStatus(exception.Message, true);
            }
            return;
        }

        lastResult = null;
        if (useCountdown)
        {
            flowPhase = LiveDrawPhase.CountingDown;
            countdownRemaining = SpinCountdownSeconds;
            var activeCuePreset = SoundCueService.GetPreset(await SoundCueService.GetActivePresetKeyAsync());
            await SoundCueService.PlayCueAsync(activeCuePreset.CountdownCue);
            StateHasChanged();

            while (countdownRemaining > 0)
            {
                await Task.Delay(1000);
                countdownRemaining--;
                StateHasChanged();
            }
        }

        flowPhase = LiveDrawPhase.Spinning;
        isSpinning = true;
        countdownRemaining = null;
        var cuePreset = SoundCueService.GetPreset(await SoundCueService.GetActivePresetKeyAsync());
        await SoundCueService.PlayCueAsync(cuePreset.SpinCue);

        var result = RouletteService.Spin(template, forced, currentRotation);

        currentRotation += result.TotalRotationDeg;
        StateHasChanged();

        int durationMs = (int)(template.SpinDurationSec * 1000) + PostSpinDelayMs;
        await Task.Delay(durationMs);

        isSpinning = false;
        lastResult = result;
        flowPhase = LiveDrawPhase.ShowingResult;
        await SoundCueService.PlayCueAsync(cuePreset.ResultCue);
        StateHasChanged();
    }

    private async Task EndActivityAndRecord()
    {
        if (template == null || lastResult == null || !CanRecordCurrentActivity || isRecording) return;

        isRecording = true;
        try
        {
            var record = await ActivityResultService.RecordRouletteActivityAsync(template.Id, lastResult);
            lastRecordedSignature = BuildRecordSignature();
            await ResultNotificationService.NotifyActivityResultAsync(record);
            SetStatus($"已記錄活動「{record.ActivityName}」結果。", false);
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to record roulette activity result in OBS view.");
            SetStatus(ex.Message, true);
        }
        finally
        {
            isRecording = false;
        }
    }

    private static string DescribeSector(double cx, double cy, double r, double startAngle, double endAngle)
    {
        var startRad = startAngle * Math.PI / 180;
        var endRad = endAngle * Math.PI / 180;
        var x1 = cx + r * Math.Cos(startRad);
        var y1 = cy + r * Math.Sin(startRad);
        var x2 = cx + r * Math.Cos(endRad);
        var y2 = cy + r * Math.Sin(endRad);
        var largeArc = (endAngle - startAngle) > 180 ? 1 : 0;
        return $"M {cx.ToString("F2")} {cy.ToString("F2")} L {x1:F2} {y1:F2} A {r:F2} {r:F2} 0 {largeArc} 1 {x2:F2} {y2:F2} Z";
    }

    private async Task ApplyLiveStateAsync(LiveDrawSessionState state)
    {
        if (state.PublicId != ActivePublicId || state.Revision < appliedRevision) return;
        appliedRevision = state.Revision;
        flowPhase = state.Phase switch
        {
            LiveDrawSessionPhase.CountingDown => LiveDrawPhase.CountingDown,
            LiveDrawSessionPhase.Animating => LiveDrawPhase.Spinning,
            LiveDrawSessionPhase.ShowingResult => LiveDrawPhase.ShowingResult,
            _ => LiveDrawPhase.Ready
        };
        countdownRemaining = state.Phase == LiveDrawSessionPhase.CountingDown && state.PhaseEndsAtUtc.HasValue
            ? Math.Max(1, (int)Math.Ceiling((state.PhaseEndsAtUtc.Value - DateTimeOffset.UtcNow).TotalSeconds))
            : null;
        isSpinning = state.Phase == LiveDrawSessionPhase.Animating;
        if (state.Phase is LiveDrawSessionPhase.Animating or LiveDrawSessionPhase.ShowingResult)
        {
            currentRotation = state.RouletteRotationDeg;
        }
        if (state.Phase == LiveDrawSessionPhase.ShowingResult && state.RouletteSegmentIndex.HasValue)
        {
            lastResult = new SpinResult
            {
                SegmentIndex = state.RouletteSegmentIndex.Value,
                SegmentTitle = state.ResultTitle ?? "",
                TotalRotationDeg = state.RouletteRotationDeg
            };
        }
        else if (state.Phase != LiveDrawSessionPhase.ShowingResult)
        {
            lastResult = null;
        }

        var preset = SoundCueService.GetPreset(await SoundCueService.GetActivePresetKeyAsync());
        if (state.Phase == LiveDrawSessionPhase.CountingDown) await SoundCueService.PlayCueAsync(preset.CountdownCue);
        if (state.Phase == LiveDrawSessionPhase.Animating) await SoundCueService.PlayCueAsync(preset.SpinCue);
        if (state.Phase == LiveDrawSessionPhase.ShowingResult) await SoundCueService.PlayCueAsync(preset.ResultCue);
        await InvokeAsync(StateHasChanged);
        if (countdownRemaining.HasValue) _ = TrackCountdownAsync(state.Revision, state.PhaseEndsAtUtc!.Value);
    }

    private async Task TrackCountdownAsync(long revision, DateTimeOffset endsAtUtc)
    {
        while (appliedRevision == revision && DateTimeOffset.UtcNow < endsAtUtc)
        {
            countdownRemaining = Math.Max(1, (int)Math.Ceiling((endsAtUtc - DateTimeOffset.UtcNow).TotalSeconds));
            await InvokeAsync(StateHasChanged);
            await Task.Delay(200);
        }
    }

    private string BuildRecordSignature()
    {
        if (template == null || lastResult == null)
        {
            return "";
        }

        return $"{template.Id}:{lastResult.SegmentIndex}:{lastResult.SegmentTitle}:{currentRotation:F4}";
    }

    private void SetStatus(string message, bool isError)
    {
        statusMessage = message;
        statusIsError = isError;
    }

    public async ValueTask DisposeAsync()
    {
        LiveDrawClient.StateChanged -= ApplyLiveStateAsync;
        await LiveDrawClient.DisposeAsync();
    }
}
