@page "/roulette/preview/{Id:int}"
@using EasyLotteryDomain.Models.Entities
@inject RouletteTemplateApiClient RouletteService
@inject ObsSessionService ObsSessionService
@inject NavigationManager NavigationManager

<PageTitle>轉盤 OBS 預覽</PageTitle>
<p class="p-4 text-muted">正在開啟共用 OBS 預覽…</p>

@code {
    [Parameter] public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var template = await RouletteService.LoadTemplateAsync(Id);
        if (template is null || template.PublicId == Guid.Empty)
        {
            NavigationManager.NavigateTo("/roulette", replace: true);
            return;
        }

        var token = await ObsSessionService.CreateObsTokenAsync("roulette", template.PublicId.ToString(), allowControl: true);
        NavigationManager.NavigateTo($"/obs/roulette/{template.PublicId:D}?controls=1#sessionToken={Uri.EscapeDataString(token)}", replace: true);
    }
}
