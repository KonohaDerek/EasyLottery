@page "/roulette/preview/{Id:int}"
@using EasyLotteryDomain.Models.Entities
@using EasyLotteryDomain.Services
@using EasyLotteryWasm.Services
@using Serilog

@inject ActivityResultService ActivityResultService
@inject ResultNotificationService ResultNotificationService
@inject RouletteService RouletteService
@inject NavigationManager NavigationManager
@inject IMessageService MessageService
@inject ObsSessionService ObsSessionService

<PageTitle>轉盤 - 預覽</PageTitle>

@if (template == null)
{
    <p>載入中…</p>
}
else
{
    <div class="roulette-preview-wrapper" style="@PreviewWrapperStyle">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0" style="color:var(--el-text);">@template.Name</h4>
            <div class="d-flex gap-2">
                <Button Color="Color.Light" Clicked="@GoBack">返回</Button>
            </div>
        </div>

        <div class="roulette-container">
            <!-- Pointer -->
            <div class="roulette-pointer">
                @if (!string.IsNullOrEmpty(template.PointerImageUrl))
                {
                    <img src="@template.PointerImageUrl" alt="指針" style="width:40px;" />
                }
                else
                {
                    <div class="default-pointer">▼</div>
                }
            </div>

            <!-- Wheel -->
            <div class="roulette-wheel-wrapper">
                <svg class="roulette-wheel @(isSpinning ? "spinning" : "")"
                     viewBox="0 0 400 400"
                     style="@WheelStyle">
                    @{
                        var segments = template.Segments.OrderBy(s => s.Index).ToList();
                        int count = segments.Count;
                        double segAngle = 360.0 / count;
                    }
                    @for (int i = 0; i < count; i++)
                    {
                        var seg = segments[i];
                        var startAngle = i * segAngle - 90;
                        var endAngle = startAngle + segAngle;
                        var midAngle = startAngle + segAngle / 2.0;
                        var path = DescribeSector(200, 200, 180, startAngle, endAngle);
                        var textX = 200 + 120 * Math.Cos(midAngle * Math.PI / 180);
                        var textY = 200 + 120 * Math.Sin(midAngle * Math.PI / 180);
                        var isWinner = lastResult != null && lastResult.SegmentIndex == i && !isSpinning;

                        <g>
                            <path d="@path" fill="@seg.Color"
                                  stroke="var(--el-border-strong)" stroke-width="2"
                                  class="@(isWinner ? "winner-segment" : "")" />
                            <text x="@textX.ToString("F1")" y="@textY.ToString("F1")"
                                  text-anchor="middle" dominant-baseline="middle"
                                  font-size="14" fill="var(--el-text)" font-weight="bold"
                                  transform="rotate(@midAngle.ToString("F1"), @textX.ToString("F1"), @textY.ToString("F1"))">
                                @seg.Title
                            </text>
                        </g>
                    }
                    <!-- Center image or circle -->
                    @if (!string.IsNullOrEmpty(template.CenterImageUrl))
                    {
                        <image href="@template.CenterImageUrl" x="160" y="160" width="80" height="80" />
                    }
                    else
                    {
                        <circle cx="200" cy="200" r="30" fill="var(--el-surface-strong)" />
                    }
                </svg>
            </div>
        </div>

        <div class="mt-3">
            <LiveDrawFlowGuide Title="直播操作流程"
                               Subtitle="@template.Name"
                               Phase="@flowPhase"
                               CountdownRemaining="@countdownRemaining"
                               DetailText="@FlowDetailText" />
        </div>

        <div class="mt-3 text-center">
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <Button Color="Color.Warning" Size="Size.Large" Clicked="@SpinWheelWithCountdown" Disabled="@IsBusy">
                    @((IsBusy && flowPhase == LiveDrawPhase.CountingDown) ? $"倒數中… {countdownRemaining}" : "⏳ 倒數 3 秒後轉動")
                </Button>
                <Button Color="Color.Warning" Size="Size.Large" Clicked="@SpinWheel" Disabled="@IsBusy">
                    @(IsBusy && flowPhase == LiveDrawPhase.Spinning ? "轉動中…" : "🎰 立即轉動")
                </Button>
                <Button Color="Color.Success" Size="Size.Large" Clicked="@EndActivityAndRecord" Disabled="@(!CanRecordCurrentActivity || isRecording)">
                    @(isRecording ? "記錄中…" : "結束本次活動並記錄")
                </Button>
            </div>
            @if (lastResult != null && !IsBusy)
            {
                <div class="win-result mt-3">
                    <span class="win-label">🎉 中獎：</span>
                    <span class="win-title">@lastResult.SegmentTitle</span>
                </div>
            }
        </div>

        <!-- OBS Browser Source -->
        <div class="mt-3">
            <details>
                <summary style="color:var(--el-text-muted);cursor:pointer;">📺 OBS 瀏覽器來源（固定網址）</summary>
                <div class="mt-2 p-3 obs-source-guide">
                    <p class="obs-source-guide-title">這是固定的 OBS 來源網址，設定一次後就可以長期使用。</p>
                    <p class="obs-source-guide-body">在 OBS 新增「瀏覽器」來源，直接貼上下面網址：</p>
                    <code class="obs-source-code">@ObsUrl</code>
                    <ul class="obs-source-list">
                        <li>建議寬高設為 <strong>480 × 600</strong></li>
                        <li>勾選「關閉時使場景不活躍」</li>
                        <li>背景已預設透明，可直接疊加在直播場景上</li>
                    </ul>
                </div>
            </details>
        </div>

        <!-- Debug: force segment -->
        <div class="mt-3">
            <details>
                <summary style="color:var(--el-text-muted);cursor:pointer;">除錯：強制指定格子</summary>
                <div class="d-flex gap-2 align-items-center mt-2">
                    <NumericInput TValue="int" @bind-Value="@forceIndex" Min="0"
                                 Max="@(template.Segments.Count - 1)" style="width:80px;" />
                    <Button Color="Color.Secondary" Size="Size.Small" Clicked="@SpinForce" Disabled="@IsBusy">
                        強制轉到格 @(forceIndex + 1)
                    </Button>
                </div>
            </details>
        </div>
    </div>
}

<style>
    .roulette-preview-wrapper {
        padding: 24px;
        border-radius: 8px;
        min-height: 500px;
        color: var(--el-text);
    }

    .roulette-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
    }

    .roulette-pointer {
        font-size: 2rem;
        color: var(--el-text);
        text-align: center;
        z-index: 10;
        margin-bottom: -10px;
    }

    .default-pointer {
        font-size: 2.5rem;
        color: var(--el-accent);
        text-shadow: 0 0 8px var(--el-glow);
    }

    .roulette-wheel-wrapper {
        width: 400px;
        height: 400px;
        border-radius: 50%;
        box-shadow: 0 0 30px rgba(0,0,0,0.35);
        overflow: hidden;
    }

    .roulette-wheel {
        width: 400px;
        height: 400px;
        transition-property: transform;
        transition-timing-function: cubic-bezier(0.17, 0.67, 0.12, 0.99);
    }

    .winner-segment {
        filter: brightness(1.4);
        stroke: var(--el-accent) !important;
        stroke-width: 4 !important;
    }

    .win-result {
        font-size: 1.4rem;
        color: var(--el-text);
    }

    .win-label {
        opacity: 0.8;
    }

    .win-title {
        font-weight: bold;
        color: var(--el-accent);
        font-size: 1.6rem;
        text-shadow: 0 0 12px var(--el-glow);
    }

    .obs-source-guide {
        background: var(--el-surface-soft);
        border-radius: 10px;
        border: 1px solid var(--el-border);
    }

    .obs-source-guide-title {
        color: var(--el-text);
        font-weight: 700;
        margin-bottom: 8px;
    }

    .obs-source-guide-body {
        color: var(--el-text-muted);
        font-size: 0.9rem;
        margin-bottom: 8px;
    }

    .obs-source-code {
        display: block;
        color: var(--el-accent);
        word-break: break-all;
        padding: 10px 12px;
        border-radius: 8px;
        background: color-mix(in srgb, var(--el-surface-strong) 82%, transparent);
        border: 1px solid var(--el-border);
    }

    .obs-source-list {
        margin: 10px 0 0;
        padding-left: 20px;
        color: var(--el-text-muted);
        font-size: 0.85rem;
        line-height: 1.6;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private RouletteTemplate? template;
    private SpinResult? lastResult;
    private bool isSpinning = false;
    private LiveDrawPhase flowPhase = LiveDrawPhase.Ready;
    private int? countdownRemaining;
    private double currentRotation = 0;
    private int forceIndex = 0;
    private bool isRecording;
    private string? lastRecordedSignature;
    private string sessionToken = "";

    private const int PostSpinDelayMs = 300;
    private const int SpinCountdownSeconds = 3;
    private bool IsBusy => isSpinning || countdownRemaining.HasValue;
    private bool CanRecordCurrentActivity => template != null && lastResult != null && !IsBusy && BuildRecordSignature() != lastRecordedSignature;

    private string FlowDetailText =>
        flowPhase switch
        {
            LiveDrawPhase.Ready => "按下倒數或立即轉動後，就會進入抽獎動畫。",
            LiveDrawPhase.CountingDown => "請先確認畫面與音效都已準備好。",
            LiveDrawPhase.Spinning => "轉盤正在轉動，等待中獎結果。",
            LiveDrawPhase.ShowingResult when lastResult != null => $"已完成抽獎，結果為「{lastResult.SegmentTitle}」。",
            _ => "抽獎已準備就緒。"
        };

    private string PreviewWrapperStyle =>
        string.IsNullOrEmpty(template?.BackgroundImageUrl)
            ? "background:var(--el-stage-bg);"
            : $"background:linear-gradient(135deg, rgba(0,0,0,0.2), rgba(0,0,0,0.55)), url('{template.BackgroundImageUrl}') center/cover;";

    private string WheelStyle =>
        $"transform: rotate({currentRotation}deg); " +
        $"transition-duration: {(isSpinning ? template?.SpinDurationSec ?? 5.0 : 0)}s;";

    protected override async Task OnInitializedAsync()
    {
        template = await RouletteService.LoadTemplateAsync(Id);
        if (template == null)
        {
            await MessageService.Error("找不到模板。");
            NavigationManager.NavigateTo("/roulette");
        }
        else if (template.PublicId != Guid.Empty)
        {
            sessionToken = await ObsSessionService.CreateObsTokenAsync("roulette", template.PublicId.ToString(), true);
        }
    }

    private async Task SpinWheel()
    {
        await StartSpinAsync(null, false);
    }

    private async Task SpinWheelWithCountdown()
    {
        await StartSpinAsync(null, true);
    }

    private async Task SpinForce()
    {
        await StartSpinAsync(forceIndex, false);
    }

    private async Task StartSpinAsync(int? forced, bool useCountdown)
    {
        if (template == null || IsBusy) return;

        lastResult = null;
        if (useCountdown)
        {
            flowPhase = LiveDrawPhase.CountingDown;
            countdownRemaining = SpinCountdownSeconds;
            StateHasChanged();

            while (countdownRemaining > 0)
            {
                await Task.Delay(1000);
                countdownRemaining--;
                StateHasChanged();
            }
        }

        flowPhase = LiveDrawPhase.Spinning;
        isSpinning = true;
        countdownRemaining = null;

        var result = RouletteService.Spin(template, forced, currentRotation);
        currentRotation += result.TotalRotationDeg;
        StateHasChanged();

        // Wait for spin animation to complete
        int durationMs = (int)(template.SpinDurationSec * 1000) + PostSpinDelayMs;
        await Task.Delay(durationMs);

        isSpinning = false;
        lastResult = result;
        flowPhase = LiveDrawPhase.ShowingResult;
        StateHasChanged();
    }

    private async Task EndActivityAndRecord()
    {
        if (template == null || lastResult == null || !CanRecordCurrentActivity || isRecording) return;

        isRecording = true;
        try
        {
            var record = await ActivityResultService.RecordRouletteActivityAsync(template.Id, lastResult);
            lastRecordedSignature = BuildRecordSignature();
            await ResultNotificationService.NotifyActivityResultAsync(record);
            await MessageService.Success($"已記錄活動「{record.ActivityName}」結果。");
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to record roulette activity result in preview.");
            await MessageService.Error(ex.Message);
        }
        finally
        {
            isRecording = false;
        }
    }

    private static string DescribeSector(double cx, double cy, double r, double startAngle, double endAngle)
    {
        var startRad = startAngle * Math.PI / 180;
        var endRad = endAngle * Math.PI / 180;
        var x1 = cx + r * Math.Cos(startRad);
        var y1 = cy + r * Math.Sin(startRad);
        var x2 = cx + r * Math.Cos(endRad);
        var y2 = cy + r * Math.Sin(endRad);
        var largeArc = (endAngle - startAngle) > 180 ? 1 : 0;
        return $"M {cx.ToString("F2")} {cy.ToString("F2")} L {x1:F2} {y1:F2} A {r:F2} {r:F2} 0 {largeArc} 1 {x2:F2} {y2:F2} Z";
    }

    private string ObsUrl => string.IsNullOrWhiteSpace(sessionToken)
        ? NavigationManager.ToAbsoluteUri($"/obs/roulette/{Id}").ToString()
        : $"{NavigationManager.ToAbsoluteUri($"/obs/roulette/{Id}").ToString()}#sessionToken={Uri.EscapeDataString(sessionToken)}";

    private string BuildRecordSignature()
    {
        if (template == null || lastResult == null)
        {
            return "";
        }

        return $"{template.Id}:{lastResult.SegmentIndex}:{lastResult.SegmentTitle}:{currentRotation:F4}";
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/roulette");
    }
}
