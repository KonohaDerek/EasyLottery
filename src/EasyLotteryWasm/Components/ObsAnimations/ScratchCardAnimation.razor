<div class="scratch-stage">
    <div class="scratch-card">
        <div class="scratch-card-heading">LUCKY SCRATCH</div>
        <div class="scratch-card-result">@PrizeName</div>
        <div class="scratch-silver"></div>
        <div class="scratch-brush"></div>
        <div class="scratch-spark scratch-spark-one"></div>
        <div class="scratch-spark scratch-spark-two"></div>
        <div class="scratch-spark scratch-spark-three"></div>
    </div>
</div>

@code {
    [Parameter] public string PrizeName { get; set; } = "";
}
